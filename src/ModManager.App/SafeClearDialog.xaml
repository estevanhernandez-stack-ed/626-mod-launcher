<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModManager.App.SafeClearDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Reset launcher"
    CloseButtonText="Cancel"
    DefaultButton="Close"
    PrimaryButtonClick="OnPrimary"
    AutomationProperties.Name="Reset launcher">

    <!-- Dialog shell (vibe-glow F-008): 3px accent rail + mono-caps stencil eyebrow + title,
         per the design language's dialog rules. Rail bleeds toward the dialog edges. -->
    <ContentDialog.Title>
        <StackPanel Spacing="6">
            <Border Height="3" Background="{StaticResource ThemeAccent}" Margin="-24,0,-24,4"
                    AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="RESET // RESTORE POINT FIRST" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.AccessibilityView="Raw"
                       FontSize="{StaticResource TagFontSize}" CharacterSpacing="80"
                       Foreground="{StaticResource ThemeInkDim}" />
            <TextBlock Text="Reset launcher" FontSize="{StaticResource ViewTitleFontSize}" FontWeight="SemiBold" />
        </StackPanel>
    </ContentDialog.Title>


    <!-- Destructive confirm: the primary is the ONE sanctioned filled-danger surface
         (design language button rules; vibe-glow F-037). Keyboard default stays on Cancel. -->
    <ContentDialog.PrimaryButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ThemeDanger}" />
            <Setter Property="Foreground" Value="{StaticResource ThemeBg}" />
        </Style>
    </ContentDialog.PrimaryButtonStyle>

    <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Width="440">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}"
                       Text="Your mods are kept. This archives your current setup to a restore point you can return to, then resets the launcher to first-run." />

            <TextBlock Text="After the reset:" FontWeight="SemiBold" FontSize="{StaticResource BodyFontSize}" />
            <ComboBox AutomationProperties.AutomationId="EndStateBox" AutomationProperties.Name="End state" x:Name="EndStateBox" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Return to vanilla (restorable)" />
                <ComboBoxItem Content="Leave mods active" />
            </ComboBox>

            <CheckBox AutomationProperties.AutomationId="CreateRestorePointBox" x:Name="CreateRestorePointBox"
                      Content="Create a restore point (recommended)"
                      IsChecked="True" />

            <ToggleSwitch AutomationProperties.AutomationId="KeepNexusSwitch" x:Name="KeepNexusSwitch"
                          Header="Keep Nexus connection"
                          IsOn="True" />

            <InfoBar x:Name="ResultBar"
                     IsOpen="False"
                     Severity="Error"
                     IsClosable="False" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
