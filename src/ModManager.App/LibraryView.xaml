<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ModManager.App.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ModManager.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource ThemeBg}">
        <!-- Empty state: nothing registered AND nothing discovered. Registered-but-nothing-installed
             is impossible here, and installed-but-nothing-registered is the discovery lane's job —
             this panel is only for the machine where 626 has genuinely nothing to offer. The old copy
             promised installed games "below once you add one," which was both false and a description
             of the bug: the lane was built and then hidden inside the collapsed content scroller. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="420"
                    Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
            <TextBlock Text="Your library is empty" FontSize="{StaticResource ViewTitleFontSize}" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Foreground="{StaticResource ThemeInk}" />
            <TextBlock Text="No installed games turned up here either — use + Game up top to point 626 at one yourself."
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource ThemeInkSoft}" />
        </StackPanel>

        <ScrollViewer Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}"
                      VerticalScrollBarVisibility="Auto" Padding="20,16,20,20">
            <StackPanel Spacing="20">

                <!-- Recent strip: big cover cards, most-recently-played first. Gone entirely when
                     nothing is registered — there is nothing to jump back into yet. -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.RegisteredGamesVisibility, Mode=OneWay}">
                    <TextBlock Text="JUMP BACK IN" FontSize="{StaticResource TagFontSize}" FontFamily="{StaticResource StencilFontFamily}" FontStretch="Condensed" FontWeight="SemiBold" CharacterSpacing="80"
                               Foreground="{StaticResource ThemeInkSoft}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecentRows, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameLibraryRowViewModel">
                                    <Button Padding="0" BorderThickness="0" Background="Transparent"
                                            Click="OnRecentClick" Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind Name}">
                                        <StackPanel Spacing="6" Width="150">
                                            <Grid Width="150" Height="200" CornerRadius="0">
                                                <!-- Themed initial placeholder when no cover art -->
                                                <Border CornerRadius="0" Background="{x:Bind Placeholder}"
                                                        Visibility="{x:Bind PlaceholderVisibility}">
                                                    <TextBlock Text="{x:Bind Initial}" FontSize="56" FontWeight="Bold"
                                                               Foreground="Black" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <Border CornerRadius="0"
                                                        Visibility="{x:Bind CoverVisibility}">
                                                    <Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="150"
                                                       Foreground="{StaticResource ThemeInk}" />
                                            <TextBlock Text="{x:Bind RecencyText}" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource ThemeInkDim}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Search + all-games list. Gated on the FULL row set, not the filtered one: a search
                     that matches nothing must keep its search box, or there is no way back out of it. -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.RegisteredGamesVisibility, Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ALL GAMES" FontSize="{StaticResource TagFontSize}" FontFamily="{StaticResource StencilFontFamily}" FontStretch="Condensed" FontWeight="SemiBold" CharacterSpacing="80"
                                   VerticalAlignment="Center" Foreground="{StaticResource ThemeInkSoft}" />
                        <!-- Cross-game Updates entry point. Present ONLY when something is actually
                             pending — an empty or never-checked library keeps the home clean rather
                             than advertising a zero. -->
                        <Button Grid.Column="1" Click="OnOpenUpdates" VerticalAlignment="Center"
                                Background="Transparent" BorderBrush="{StaticResource ThemeAccent}" BorderThickness="1"
                                Foreground="{StaticResource ThemeAccent}"
                                Content="{x:Bind ViewModel.UpdatesEntryText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.UpdatesEntryVisibility, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.UpdatesEntryTooltip, Mode=OneWay}" />
                        <TextBox Grid.Column="2" Width="220" PlaceholderText="Search games…"
                                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameLibraryRowViewModel">
                                <!-- The whole row opens the game (OnManage -> OpenGameCommand). A panel-styled
                                     Button gives hover/pressed/keyboard for free; the inner Play button
                                     handles its own click so it won't also open the game. -->
                                <Button Click="OnManage" Tag="{x:Bind}" Margin="0,0,0,6"
                                        AutomationProperties.Name="{x:Bind Name}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="{StaticResource ThemePanel}" BorderThickness="0"
                                        Padding="0" CornerRadius="0"
                                        ToolTipService.ToolTip="Open this game's mods">
                                <Grid Padding="10,10" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Cover / placeholder thumbnail -->
                                    <Grid Grid.Column="0" Width="60" Height="80" CornerRadius="0"
                                          VerticalAlignment="Center">
                                        <Border CornerRadius="0" Background="{x:Bind Placeholder}"
                                                Visibility="{x:Bind PlaceholderVisibility}">
                                            <TextBlock Text="{x:Bind Initial}" FontSize="26" FontWeight="Bold"
                                                       Foreground="Black" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border CornerRadius="0"
                                                Visibility="{x:Bind CoverVisibility}">
                                            <Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
                                        </Border>
                                    </Grid>

                                    <!-- Body: name + source/recency line + mod state + chips -->
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="{StaticResource RowTitleFontSize}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource ThemeInk}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind SourceBadge}" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource ThemeInkSoft}"
                                                       Visibility="{x:Bind SourceBadgeVisibility}" />
                                            <TextBlock Text="{x:Bind RecencyText}" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource ThemeInkDim}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ModStateText}" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource ThemeInkSoft}" />

                                        <!-- Chips: tier · ban risk · detected loaders -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                            <Border CornerRadius="0" Padding="6,2" Background="{StaticResource ThemeBarBg}"
                                                    BorderThickness="1" BorderBrush="{StaticResource ThemeBorder}"
                                                    ToolTipService.ToolTip="{x:Bind TierTooltip}">
                                                <TextBlock AutomationProperties.HelpText="{x:Bind TierTooltip}" Foreground="{StaticResource ThemeInk}" Text="{x:Bind TierChip}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MetaFontSize}" />
                                            </Border>
                                            <Border CornerRadius="0" Padding="6,2" Background="Transparent" BorderBrush="{StaticResource ThemeAccent}" BorderThickness="1"
                                                    ToolTipService.ToolTip="{x:Bind UpdateBadgeTooltip}"
                                                    Visibility="{x:Bind UpdateBadgeVisibility}">
                                                <TextBlock AutomationProperties.HelpText="{x:Bind UpdateBadgeTooltip}" Text="{x:Bind UpdateBadgeText}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MetaFontSize}"
                                                           Foreground="{StaticResource ThemeAccent}" />
                                            </Border>
                                            <Border CornerRadius="0" Padding="6,2" Background="{StaticResource ThemeBarBg}"
                                                    BorderThickness="1" BorderBrush="{StaticResource ThemeDanger}"
                                                    ToolTipService.ToolTip="This game uses anti-cheat — modding for online play can get your account banned"
                                                    Visibility="{x:Bind BanRiskVisibility}">
                                                <TextBlock AutomationProperties.HelpText="This game uses anti-cheat — modding for online play can get your account banned" Text="BAN RISK" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MetaFontSize}"
                                                           Foreground="{StaticResource ThemeDanger}" />
                                            </Border>
                                            <Border CornerRadius="0" Padding="6,2" Background="{StaticResource ThemeBarBg}"
                                                    BorderThickness="1" BorderBrush="{StaticResource ThemeAccent}"
                                                    ToolTipService.ToolTip="Mod loaders detected in this game's folder"
                                                    Visibility="{x:Bind LoaderVisibility}">
                                                <TextBlock AutomationProperties.HelpText="Mod loaders detected in this game's folder" Text="{x:Bind LoaderChip}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MetaFontSize}"
                                                           Foreground="{StaticResource ThemeAccent}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Play: launch the game's current on-disk state. The vanilla/modded
                                         toggle lives in the game view, coupled to the active context. -->
                                    <Button Grid.Column="2" VerticalAlignment="Center"
                                            Content="Play" Foreground="{StaticResource ThemeBg}"
                                            Background="{StaticResource ThemeAccent}"
                                            Click="OnPlay" Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Launch this game" />

                                </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Discovery lane: installed games not added yet. Opens itself when it is the only
                     section on the page (nothing registered, something discovered) and stays shut
                     otherwise, so the established home is unchanged. -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="{x:Bind ViewModel.DiscoveryExpanded, Mode=OneWay}"
                          Background="{StaticResource ThemePanel}">
                    <Expander.Header>
                        <TextBlock Text="Installed games not added yet" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="8" Padding="0,4,0,4">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DiscoveryRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiscoveredGameViewModel">
                                    <Grid Padding="8" ColumnSpacing="12" Margin="0,0,0,4"
                                          Background="{StaticResource ThemeBarBg}" CornerRadius="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="40" Height="54" CornerRadius="0"
                                              VerticalAlignment="Center">
                                            <Border CornerRadius="0" Background="{x:Bind Placeholder}"
                                                    Visibility="{x:Bind PlaceholderVisibility}">
                                                <TextBlock Text="{x:Bind Initial}" FontSize="18" FontWeight="Bold"
                                                           Foreground="Black" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Border CornerRadius="0"
                                                    Visibility="{x:Bind CoverVisibility}">
                                                <Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Foreground="{StaticResource ThemeInk}" Text="{x:Bind Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind StoreKind}" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource ThemeInkDim}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="+ Add" VerticalAlignment="Center"
                                                Click="OnAddDiscovered" Tag="{x:Bind}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Nothing new — every installed game 626 can see is already in your library."
                                   Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}"
                                   Visibility="{x:Bind ViewModel.DiscoveryEmptyVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
