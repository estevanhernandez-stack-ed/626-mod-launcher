<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModManager.App.Vortex.VortexTakeoverDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Take over folder"
    CloseButtonText="Not now"
    DefaultButton="Primary"
    AutomationProperties.Name="Vortex manages this folder">

    <!-- Dialog shell (vibe-glow F-008): 3px accent rail + mono-caps stencil eyebrow + title,
         per the design language's dialog rules. Rail bleeds toward the dialog edges. -->
    <ContentDialog.Title>
        <StackPanel Spacing="6">
            <Border Height="3" Background="{StaticResource ThemeAccent}" Margin="-24,0,-24,4"
                    AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="VORTEX // TAKE OVER" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.AccessibilityView="Raw"
                       FontSize="{StaticResource TagFontSize}" CharacterSpacing="80"
                       Foreground="{StaticResource ThemeInkDim}" />
            <TextBlock Text="Vortex manages this folder" FontSize="20" FontWeight="SemiBold" />
        </StackPanel>
    </ContentDialog.Title>

    <StackPanel Spacing="8">
        <TextBlock x:Name="BodyText" TextWrapping="Wrap" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}"
                   Text="After this, manage these mods in the launcher — re-deploying in Vortex may undo your changes." />
    </StackPanel>
</ContentDialog>
