<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModManager.App.Frameworks.FrameworkInstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Install"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    AutomationProperties.Name="Install framework">

    <!-- Dialog shell (vibe-glow F-008): 3px accent rail + mono-caps stencil eyebrow + title,
         per the design language's dialog rules. Rail bleeds toward the dialog edges. -->
    <ContentDialog.Title>
        <StackPanel Spacing="6">
            <Border Height="3" Background="{StaticResource ThemeAccent}" Margin="-24,0,-24,4"
                    AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="FRAMEWORK // VALIDATE THEN EXTRACT" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.AccessibilityView="Raw"
                       FontSize="{StaticResource TagFontSize}" CharacterSpacing="80"
                       Foreground="{StaticResource ThemeInkDim}" />
            <TextBlock Text="Install framework" FontSize="{StaticResource ViewTitleFontSize}" FontWeight="SemiBold" />
        </StackPanel>
    </ContentDialog.Title>


    <!-- Confirmation dialog before the launcher extracts a recognized framework zip into the game
         root. Surfaces the framework's author + URL, the file list from the zip, and (if any) a
         warning about files that will be replaced + where their backup will live. Primary action
         runs FrameworkInstaller.Install via the caller (MainViewModel). -->
    <StackPanel Spacing="12" Width="440">
        <TextBlock x:Name="HeadlineText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="AuthorText" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap" />
        <TextBlock Text="Files that will be installed:" FontWeight="SemiBold" FontSize="{StaticResource BodyFontSize}" />
        <ListView x:Name="FilesList" MaxHeight="200" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Foreground="{StaticResource ThemeInk}" Text="{x:Bind}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MetaFontSize}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="OverwriteWarning" Foreground="{StaticResource ThemeWarning}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap"
                   Visibility="Collapsed" />
        <TextBlock x:Name="LocationText" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource MetaFontSize}" TextWrapping="Wrap" />
        <TextBlock Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource MetaFontSize}" TextWrapping="Wrap"
                   Text="Reversible — remove it from its chip in the tools row. The launcher snapshots replaced files before extraction and puts them back." />
    </StackPanel>
</ContentDialog>
