<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModManager.App.AddGameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Add"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimary"
    AutomationProperties.Name="Add a game">

    <!-- Dialog shell (vibe-glow F-008): 3px accent rail + mono-caps stencil eyebrow + title,
         per the design language's dialog rules. Rail bleeds toward the dialog edges. -->
    <ContentDialog.Title>
        <StackPanel Spacing="6">
            <Border Height="3" Background="{StaticResource ThemeAccent}" Margin="-24,0,-24,4"
                    AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="LIBRARY // ADD GAME" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.AccessibilityView="Raw"
                       FontSize="{StaticResource TagFontSize}" CharacterSpacing="80"
                       Foreground="{StaticResource ThemeInkDim}" />
            <TextBlock Text="Add a game" FontSize="{StaticResource ViewTitleFontSize}" FontWeight="SemiBold" />
        </StackPanel>
    </ContentDialog.Title>


    <!-- The dialog (AI + Batch expanders, Steam quick-add, the full manual form) is taller than a
         ContentDialog can show, especially under display scaling — and a ContentDialog does not scroll
         its own content. Without this wrap, everything below the name box clips off the bottom with no
         way to reach it (engine, game folder, Browse, the validation error). Mirrors SettingsDialog. -->
    <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12" Width="440">
        <!-- The recommended path leads (F-026): detected Steam games + filter first, the
             popular picker next, AI/batch expanders demoted below — power flows sit under the
             path most users should take. -->
        <StackPanel Spacing="6">
            <TextBlock Text="Quick add from Steam" FontWeight="SemiBold" FontSize="{StaticResource BodyFontSize}" />
            <TextBlock Text="Check the games to add — engine, folder, and saves are detected for you. Then click Add."
                       TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}" />
            <TextBox AutomationProperties.AutomationId="SteamFilterBox" AutomationProperties.Name="Filter detected games" x:Name="SteamFilterBox" PlaceholderText="Filter detected games…"
                     TextChanged="OnSteamFilterChanged"
                     ToolTipService.ToolTip="Narrow the detected list — checked games stay checked while you filter" />
            <ListView AutomationProperties.AutomationId="SteamGamesList" AutomationProperties.Name="Detected games" x:Name="SteamGamesList" SelectionMode="Multiple" MaxHeight="180"
                      BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1"
                      SelectionChanged="OnSteamSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="46" Height="22" CornerRadius="0"
                                    Background="{ThemeResource ControlElevationBorderBrush}">
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Foreground="{StaticResource ThemeInk}" Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="SteamEmptyNote" Visibility="Collapsed"
                       Text="No installed Steam games detected." Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}" />
            <TextBlock x:Name="SteamSetupHeader" Visibility="Collapsed" Margin="0,6,0,0"
                       Text="Set up (engine not detected)" FontWeight="SemiBold" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource ThemeInkSoft}" />
            <ListView AutomationProperties.AutomationId="SteamSetupList" x:Name="SteamSetupList" Visibility="Collapsed" SelectionMode="None" MaxHeight="160"
                      BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="46" Height="22" CornerRadius="0"
                                    Background="{ThemeResource ControlElevationBorderBrush}">
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Foreground="{StaticResource ThemeInk}" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                            <Button AutomationProperties.AutomationId="SteamSetupButton" Grid.Column="2" Content="Set up" Click="OnSteamSetup" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="SteamSelectionStatus" Visibility="Collapsed" FontSize="{StaticResource BodyFontSize}" />
        </StackPanel>
        <ComboBox AutomationProperties.AutomationId="PopularGamesBox" x:Name="PopularGamesBox" Header="Popular game (optional)" HorizontalAlignment="Stretch"
                  DisplayMemberPath="Name" PlaceholderText="Pick a known moddable game"
                  SelectionChanged="OnPopularSelected" />
        <Expander x:Name="AiExpander" HorizontalAlignment="Stretch" Header="Add with AI">
            <StackPanel Spacing="{StaticResource SpaceM}" Width="400">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}"
                           Text="Type the game name, copy the prompt into any AI chat, paste the JSON it returns, then Apply to pre-fill the wizard." />
                <TextBox AutomationProperties.AutomationId="AiGameNameBox" x:Name="AiGameNameBox" Header="Game name" PlaceholderText="e.g. Elden Ring" />
                <Button AutomationProperties.AutomationId="CopyProfilePromptButton" Content="Copy prompt" Click="OnCopyProfilePrompt" />
                <TextBox AutomationProperties.AutomationId="AiJsonBox" x:Name="AiJsonBox" Header="Pasted JSON" AcceptsReturn="True" Height="150" TextWrapping="Wrap"
                         PlaceholderText="Paste the JSON the agent returned" />
                <Button AutomationProperties.AutomationId="ApplyProfileButton" Content="Apply definition" Click="OnApplyProfile" />
                <TextBlock x:Name="ProfileStatus" Visibility="Collapsed" TextWrapping="Wrap" FontSize="{StaticResource BodyFontSize}" />
            </StackPanel>
        </Expander>
        <Expander x:Name="BatchExpander" HorizontalAlignment="Stretch" Header="Batch from Steam (multiple games)">
            <StackPanel Spacing="{StaticResource SpaceM}" Width="400">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}"
                           Text="Pick the Steam games you want to onboard, copy the batch prompt into your agent, paste the JSON array back, then Apply all. Definitions that pass register on Add; the rest are skipped." />
                <ListView AutomationProperties.AutomationId="BatchSteamList" x:Name="BatchSteamList" SelectionMode="Multiple" Height="160"
                          BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{StaticResource ThemeInk}" Text="{Binding Name}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button AutomationProperties.AutomationId="CopyBatchPromptButton" Content="Copy batch prompt" Click="OnCopyBatchPrompt" />
                <TextBox AutomationProperties.AutomationId="BatchJsonBox" x:Name="BatchJsonBox" Header="Pasted JSON array" AcceptsReturn="True" Height="120" TextWrapping="Wrap"
                         PlaceholderText="Paste the JSON array the agent returned" />
                <Button AutomationProperties.AutomationId="ApplyBatchButton" Content="Apply all" Click="OnApplyBatch" />
                <TextBlock x:Name="BatchStatus" Visibility="Collapsed" TextWrapping="Wrap" FontSize="{StaticResource BodyFontSize}" />
                <ItemsControl x:Name="BatchResultsList" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1"
                                    CornerRadius="0" Padding="8" Margin="0,0,0,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Foreground="{StaticResource ThemeInk}" Text="{Binding Headline}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>
        <StackPanel x:Name="ManualFormPanel" Spacing="12">
        <TextBlock Text="Or add one manually" FontWeight="SemiBold" FontSize="{StaticResource BodyFontSize}" />
        <TextBox AutomationProperties.AutomationId="GameNameBox" x:Name="NameBox" Header="Game name" PlaceholderText="e.g. Windrose" />
        <StackPanel Spacing="2">
            <ComboBox AutomationProperties.AutomationId="EngineBox" x:Name="EngineBox" Header="Engine" HorizontalAlignment="Stretch"
                      DisplayMemberPath="Label" PlaceholderText="Select engine…"
                      SelectionChanged="OnEngineChanged" />
            <TextBlock x:Name="EngineHint" Foreground="{StaticResource ThemeAccent}" FontSize="{StaticResource BodyFontSize}"
                       Visibility="Collapsed" Text="Auto-detected from the game folder — change if it's wrong." />
            <HyperlinkButton AutomationProperties.AutomationId="RequestGameLink" x:Name="RequestGameLink" Visibility="Collapsed"
                             Click="OnRequestGame" Padding="0,2,0,0"
                             Content="Can't find the engine? Request this game" FontSize="{StaticResource BodyFontSize}" />
        </StackPanel>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox AutomationProperties.AutomationId="FolderBox" x:Name="FolderBox" Grid.Column="0" Header="Game folder"
                     PlaceholderText="C:\...\steamapps\common\YourGame" />
            <Button AutomationProperties.AutomationId="BrowseButton" x:Name="BrowseButton" Grid.Column="1" Content="Browse" VerticalAlignment="Bottom" Click="OnBrowse" />
        </Grid>
        <TextBox AutomationProperties.AutomationId="ModPathBox" x:Name="ModPathBox" Header="Mod folder (relative to the game folder)" />
        <TextBox AutomationProperties.AutomationId="SteamAppIdBox" x:Name="SteamBox" Header="Steam App ID (optional — enables Launch)" />
        <ComboBox AutomationProperties.AutomationId="SaveRootBox" x:Name="SaveRootBox" Header="Save root (optional)" HorizontalAlignment="Stretch"
                  PlaceholderText="Where saves live" />
        <TextBox AutomationProperties.AutomationId="SaveSubPathBox" x:Name="SaveSubPathBox" Header="Save subfolder (relative to the save root, optional)" />
        <TextBox AutomationProperties.AutomationId="RequiredLauncherBox" x:Name="RequiredLauncherBox" Header="Required launcher (relative exe, optional)" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ThemeDanger}" Visibility="Collapsed"
                   Text="Name, game folder, and engine are required." TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</ContentDialog>
