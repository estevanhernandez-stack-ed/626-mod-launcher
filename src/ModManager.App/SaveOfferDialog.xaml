<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModManager.App.SaveOfferDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="None"
    AutomationProperties.Name="No characters in this save yet">

    <!-- Same shell as PatchDayDialog: accent rail, mono eyebrow, title. -->
    <ContentDialog.Title>
        <StackPanel Spacing="6">
            <Border Height="3" Background="{StaticResource ThemeAccent}" Margin="-24,0,-24,4"
                    AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="SAVES // PLAY" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.AccessibilityView="Raw"
                       FontSize="{StaticResource TagFontSize}" CharacterSpacing="80"
                       Foreground="{StaticResource ThemeInkDim}" />
            <TextBlock x:Name="TitleText" FontSize="{StaticResource ViewTitleFontSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
    </ContentDialog.Title>

    <!-- No built-in buttons: each choice is a real Button with its own AutomationId. Escape closes with nothing
         chosen, and nothing launches. -->
    <StackPanel Spacing="12" Width="460">
        <TextBlock AutomationProperties.AutomationId="SaveOfferDialog" x:Name="SentenceText"
                   TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}" />

        <!-- One source: a sentence. Several: one radio button each, newest first and checked. -->
        <TextBlock AutomationProperties.AutomationId="SaveOfferSourceDetail" x:Name="SourceDetailText"
                   TextWrapping="Wrap" FontSize="{StaticResource BodyFontSize}" />
        <StackPanel x:Name="SourcesPanel" Spacing="4" />

        <TextBlock AutomationProperties.AutomationId="SaveOfferWarning" x:Name="WarningText" Visibility="Collapsed"
                   TextWrapping="Wrap" Foreground="{StaticResource ThemeWarning}" FontSize="{StaticResource BodyFontSize}"
                   Text="This character goes online with anti-cheat on. If it picked up anything a mod added, that could flag your account." />
        <CheckBox AutomationProperties.AutomationId="SaveOfferAcknowledge" x:Name="AcknowledgeBox" Visibility="Collapsed"
                  Checked="OnAcknowledgeChanged" Unchecked="OnAcknowledgeChanged" />

        <StackPanel Spacing="8">
            <Button AutomationProperties.AutomationId="SaveOfferCopyAndPlay" AutomationProperties.Name="Copy and play"
                    x:Name="CopyButton" Content="Copy and play" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnCopy" />
            <Button AutomationProperties.AutomationId="SaveOfferPlayWithout" AutomationProperties.Name="Play without copying"
                    Content="Play without copying" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnPlayWithout" />
            <Button AutomationProperties.AutomationId="SaveOfferDontAsk" AutomationProperties.Name="Don't ask for this game"
                    Content="Don't ask for this game" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnDontAsk" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
