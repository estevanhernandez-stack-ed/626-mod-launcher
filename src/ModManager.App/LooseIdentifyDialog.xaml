<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModManager.App.LooseIdentifyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancel" DefaultButton="Primary"
    AutomationProperties.Name="Identify loose mods on Nexus">

    <!-- Dialog shell (vibe-glow F-008): 3px accent rail + mono-caps stencil eyebrow + title,
         per the design language's dialog rules. Rail bleeds toward the dialog edges. -->
    <ContentDialog.Title>
        <StackPanel Spacing="6">
            <Border Height="3" Background="{StaticResource ThemeAccent}" Margin="-24,0,-24,4"
                    AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="NEXUS // IDENTIFY LOOSE" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.AccessibilityView="Raw"
                       FontSize="{StaticResource TagFontSize}" CharacterSpacing="80"
                       Foreground="{StaticResource ThemeInkDim}" />
            <TextBlock Text="Identify loose mods on Nexus" FontSize="{StaticResource ViewTitleFontSize}" FontWeight="SemiBold" />
        </StackPanel>
    </ContentDialog.Title>

    <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" MinWidth="460">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}"
                       Text="Best Nexus name-search match per unidentified loose file. Check the rows to keep — nothing is saved until you hit Apply, and a later exact match (archive md5, manual URL) can still supersede a name match." />
            <ItemsControl x:Name="ProposalList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2,0,2">
                            <CheckBox Visibility="{Binding MatchVisibility}"
                                      IsChecked="{Binding Approve, Mode=TwoWay}" Click="OnRowClick">
                                <StackPanel Spacing="2">
                                    <TextBlock Foreground="{StaticResource ThemeInk}" Text="{Binding Headline}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource ThemeInkDim}"
                                               FontSize="{StaticResource BodyFontSize}" Visibility="{Binding DetailVisibility}" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="{Binding Headline}" Foreground="{StaticResource ThemeInkDim}" TextWrapping="Wrap"
                                       Visibility="{Binding NoMatchVisibility}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
