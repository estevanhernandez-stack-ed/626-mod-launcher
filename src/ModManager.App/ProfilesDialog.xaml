<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModManager.App.ProfilesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModManager.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CloseButtonText="Close"
    DefaultButton="Close"
    AutomationProperties.Name="Profiles">

    <!-- Dialog shell (vibe-glow F-008): 3px accent rail + mono-caps stencil eyebrow + title,
         per the design language's dialog rules. Rail bleeds toward the dialog edges. -->
    <ContentDialog.Title>
        <StackPanel Spacing="6">
            <Border Height="3" Background="{StaticResource ThemeAccent}" Margin="-24,0,-24,4"
                    AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="LOADOUTS // PROFILES" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.AccessibilityView="Raw"
                       FontSize="{StaticResource TagFontSize}" CharacterSpacing="80"
                       Foreground="{StaticResource ThemeInkDim}" />
            <TextBlock Text="Profiles" FontSize="20" FontWeight="SemiBold" />
        </StackPanel>
    </ContentDialog.Title>


    <StackPanel Spacing="12" Width="420">
        <TextBlock Foreground="{StaticResource ThemeInkSoft}" FontSize="12" TextWrapping="Wrap"
                   Text="A profile saves which mods are on/off. Save your current loadout, then switch between them." />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NameBox" Grid.Column="0" Header="Save current loadout as" PlaceholderText="e.g. Hardcore" />
            <Button Grid.Column="1" Content="Save" VerticalAlignment="Bottom" Click="OnSave" />
        </Grid>

        <ListView x:Name="ProfileList" MaxHeight="260" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ProfileRow">
                    <Grid ColumnSpacing="8" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{StaticResource ThemeInk}" Grid.Column="0" Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Content="Load" Click="OnLoad" VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind LoadAutomationName}" />
                        <Button Grid.Column="2" AutomationProperties.Name="{x:Bind DeleteAutomationName}" Click="OnDelete" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Delete profile">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource ThemeDanger}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyText" Text="No profiles yet." Foreground="{StaticResource ThemeInkDim}" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource ThemeInkSoft}" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
