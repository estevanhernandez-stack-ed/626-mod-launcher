<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModManager.App.NewThemeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Import"
    CloseButtonText="Close"
    DefaultButton="Primary"
    PrimaryButtonClick="OnImport"
    AutomationProperties.Name="New theme">

    <!-- Dialog shell (vibe-glow F-008): 3px accent rail + mono-caps stencil eyebrow + title,
         per the design language's dialog rules. Rail bleeds toward the dialog edges. -->
    <ContentDialog.Title>
        <StackPanel Spacing="6">
            <Border Height="3" Background="{StaticResource ThemeAccent}" Margin="-24,0,-24,4"
                    AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="THEME // AI-ASSISTED" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.AccessibilityView="Raw"
                       FontSize="{StaticResource TagFontSize}" CharacterSpacing="80"
                       Foreground="{StaticResource ThemeInkDim}" />
            <TextBlock Text="New theme" FontSize="20" FontWeight="SemiBold" />
        </StackPanel>
    </ContentDialog.Title>


    <StackPanel Spacing="10" Width="460">
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}" FontSize="12"
                   Text="Describe a vibe, copy the prompt into any AI chat, paste the JSON it returns below, then Import." />
        <TextBox x:Name="VibeBox" Header="Vibe" PlaceholderText="e.g. deep ocean bioluminescence" />
        <Button Content="Copy prompt" Click="OnCopyPrompt" />
        <TextBox x:Name="JsonBox" Header="Pasted JSON" AcceptsReturn="True" Height="170" TextWrapping="Wrap"
                 TextChanged="OnJsonChanged"
                 PlaceholderText="Paste the JSON the AI returned" />
        <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" />
    </StackPanel>
</ContentDialog>
