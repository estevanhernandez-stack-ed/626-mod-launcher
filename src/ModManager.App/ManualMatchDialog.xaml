<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModManager.App.ManualMatchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Apply"
    CloseButtonText="Close"
    DefaultButton="Primary"
    AutomationProperties.Name="Match to a mod">

    <!-- Dialog shell (vibe-glow F-008): 3px accent rail + mono-caps stencil eyebrow + title,
         per the design language's dialog rules. Rail bleeds toward the dialog edges. -->
    <ContentDialog.Title>
        <StackPanel Spacing="6">
            <Border Height="3" Background="{StaticResource ThemeAccent}" Margin="-24,0,-24,4"
                    AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="NEXUS // MANUAL MATCH" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.AccessibilityView="Raw"
                       FontSize="{StaticResource TagFontSize}" CharacterSpacing="80"
                       Foreground="{StaticResource ThemeInkDim}" />
            <TextBlock Text="Match to a mod" FontSize="{StaticResource ViewTitleFontSize}" FontWeight="SemiBold" />
        </StackPanel>
    </ContentDialog.Title>


    <StackPanel Spacing="12" Width="440">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}" />
        <TextBox x:Name="UrlBox" Header="Mod page URL"
                 PlaceholderText="https://www.nexusmods.com/eldenring/mods/510 or https://www.curseforge.com/.../mods/..." />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource MetaFontSize}"
                   Text="Paste the URL from the mod's Nexus or CurseForge page. We'll pull the title, author, downloads, and icon. The match locks — future rescans won't override it." />
    </StackPanel>
</ContentDialog>
