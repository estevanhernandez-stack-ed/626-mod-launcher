<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModManager.App.UpdateModsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Apply" CloseButtonText="Cancel" DefaultButton="Primary"
    AutomationProperties.Name="Update installed mods?">

    <!-- Dialog shell (vibe-glow F-008): 3px accent rail + mono-caps stencil eyebrow + title,
         per the design language's dialog rules. Rail bleeds toward the dialog edges. -->
    <ContentDialog.Title>
        <StackPanel Spacing="6">
            <Border Height="3" Background="{StaticResource ThemeAccent}" Margin="-24,0,-24,4"
                    AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="NEXUS // UPDATES" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.AccessibilityView="Raw"
                       FontSize="{StaticResource TagFontSize}" CharacterSpacing="80"
                       Foreground="{StaticResource ThemeInkDim}" />
            <TextBlock Text="Update installed mods?" FontSize="{StaticResource ViewTitleFontSize}" FontWeight="SemiBold" />
        </StackPanel>
    </ContentDialog.Title>

    <StackPanel Spacing="8" MinWidth="420">
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}"
                   Text="These files are already installed. Check the ones to replace — the old version is kept and can be reverted." />
        <CheckBox AutomationProperties.AutomationId="ReplaceAllBox" x:Name="ReplaceAllBox" Content="Replace all" Click="OnReplaceAllClick" />
        <ItemsControl x:Name="CollisionList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Replace, Mode=TwoWay}" Click="OnRowClick" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="AddsHeader" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" />
        <ItemsControl x:Name="AddsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" /></DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ContentDialog>
