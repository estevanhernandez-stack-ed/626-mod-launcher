<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModManager.App.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ModManager.Core.Tools"
    xmlns:local="using:ModManager.App"
    PrimaryButtonText="Apply"
    CloseButtonText="Close"
    DefaultButton="Primary"
    PrimaryButtonClick="OnApply"
    AutomationProperties.Name="Settings">

    <!-- Dialog shell (vibe-glow F-008): 3px accent rail + mono-caps stencil eyebrow + title,
         per the design language's dialog rules. Rail bleeds toward the dialog edges. -->
    <ContentDialog.Title>
        <StackPanel Spacing="6">
            <Border Height="3" Background="{StaticResource ThemeAccent}" Margin="-24,0,-24,4"
                    AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="APP // SETTINGS" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.AccessibilityView="Raw"
                       FontSize="{StaticResource TagFontSize}" CharacterSpacing="80"
                       Foreground="{StaticResource ThemeInkDim}" />
            <TextBlock Text="Settings" FontSize="{StaticResource ViewTitleFontSize}" FontWeight="SemiBold" />
        </StackPanel>
    </ContentDialog.Title>


    <!-- The scrollbar is an OVERLAY in WinUI: it draws on top of the content rather than taking
         width from it, so long wrapped copy runs underneath it and the last few characters of a line
         are unreadable. Reserving a gutter is the fix - the bar has somewhere to be. -->
    <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{StaticResource SpaceM}" Width="460" Margin="0,0,14,0">

            <!-- Four groups and a footer, in consequence order (wave 9 / D1).

                 It was ONE scroll with NINE headings: Identity, palette, transparency, Nexus Mods,
                 About, Installed tools, Installed frameworks, Direct-inject mod configs, Reset,
                 Restore points. About sat FOURTH - the thing nobody opens Settings for, above three
                 things they might - and three inventories occupied the middle of a dialog you came to
                 in order to change a setting.

                 Still one scroll, not a rail. Decided by COUNT, not by growth: a rail would put Reset
                 behind a click, and bottom-of-scroll is the danger convention.

                 The inventories left. Two of their actions lived ONLY here, so they were rehomed
                 BEFORE this section was deleted, not after: framework Uninstall is on the framework
                 chip in the tools row, and the direct-inject config Override is on the mod row - it is
                 per-mod configuration, and the Settings version listed every catalog mod whether or
                 not you had it, which made it a catalog browser filed under settings.

                 Restore points get their own heading rather than sitting under Reset. D1 is emphatic:
                 they are NOT danger, they are the undo FOR it, and filing them under a danger heading
                 teaches someone to fear the control that saves them. They sit immediately above it so
                 the relationship stays legible. -->

            <!-- ============ Appearance ============ -->
            <StackPanel AutomationProperties.AutomationId="SettingsGroup.appearance"
                        AutomationProperties.Name="Appearance" Spacing="{StaticResource SpaceM}">
                <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="{StaticResource RowTitleFontSize}" />
                <!-- ============ IDENTITY ============ -->
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}"
                           Text="Pick an image — a Discord avatar, a screenshot, a photo. Use it as the launcher's icon and derive a theme from its colors. Everything stays on your machine." />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Seeded with the launcher's OWN icon when no avatar is set. An empty square
                         beside "Pick image…" says nothing about what the control does; showing what
                         is there now makes the swap obvious before anyone commits to it. -->
                    <Border Grid.Column="0" Width="96" Height="96" CornerRadius="0"
                            Background="{StaticResource ThemePanel}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1">
                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <Button AutomationProperties.AutomationId="PickImageButton" Content="Pick image…" Click="OnPickImage" />
                        <Button AutomationProperties.AutomationId="RemoveAvatarButton" x:Name="RemoveButton" Content="Remove avatar" Click="OnRemove" Visibility="Collapsed" />
                        <TextBlock x:Name="FileLabel" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource MetaFontSize}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Extracted palette" FontWeight="SemiBold" Margin="0,4,0,0" />
                <StackPanel x:Name="PaletteStrip" Orientation="Horizontal" Spacing="6" Height="32" />
                <TextBlock x:Name="PaletteEmpty" Text="Pick an image to see its dominant colors." Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" />

                <CheckBox AutomationProperties.AutomationId="UseAsIconCheck" x:Name="UseAsIconCheck" Content="Use this image as the launcher's icon" IsChecked="True" />
                <CheckBox AutomationProperties.AutomationId="DeriveThemeCheck" x:Name="DeriveThemeCheck" Content="Save a theme derived from these colors" IsChecked="True" />
                <TextBox AutomationProperties.AutomationId="ThemeNameBox" x:Name="ThemeNameBox" Header="Theme name" Text="From avatar" />

                <!-- Window transparency. Sits with the icon options because both control how the
                     launcher LOOKS on the desktop. Applies immediately (no Apply button needed). -->
                <StackPanel Orientation="Vertical" Spacing="2" Margin="0,8,0,0">
                    <TextBlock Text="Window transparency" FontWeight="SemiBold" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource ThemeInkSoft}" />
                    <ComboBox AutomationProperties.AutomationId="BackdropBox" AutomationProperties.Name="Window transparency" x:Name="BackdropBox" SelectionChanged="OnBackdropChanged"
                              ToolTipService.ToolTip="Solid keeps your theme's background opaque. Mica lets a hint of the desktop tint show through. Acrylic is more translucent.">
                        <ComboBoxItem Content="Solid" Tag="solid" />
                        <ComboBoxItem Content="Mica (subtle)" Tag="mica" />
                        <ComboBoxItem Content="Acrylic (more translucent)" Tag="acrylic" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- Divider -->
            <Border BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Margin="0,8,0,0" />

            <!-- ============ Accounts ============ -->
            <StackPanel AutomationProperties.AutomationId="SettingsGroup.accounts"
                        AutomationProperties.Name="Accounts" Spacing="{StaticResource SpaceM}">
                <TextBlock Text="Accounts" FontWeight="SemiBold" FontSize="{StaticResource RowTitleFontSize}" />
                <!-- ============ NEXUS MODS ============ -->

                <!-- Connected banner (visible when connected) -->
                <Border x:Name="NexusConnectedBanner" Visibility="Collapsed"
                        Background="{StaticResource ThemePanel}" BorderBrush="{StaticResource ThemeAccent}"
                        BorderThickness="0,0,0,2" Padding="12,10,12,10" CornerRadius="0">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{StaticResource ThemeAccent}" VerticalAlignment="Center" />
                        <TextBlock x:Name="NexusConnectedText" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="NexusExplainer" TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button AutomationProperties.AutomationId="NexusConnectButton" x:Name="NexusConnectButton" Content="Connect Nexus account" Click="OnNexusConnect" />
                    <Button AutomationProperties.AutomationId="NexusDisconnectButton" x:Name="NexusDisconnectButton" Content="Disconnect" Click="OnNexusDisconnect" Visibility="Collapsed" />
                </StackPanel>

                <!-- Dark-window note: shown (button disabled) until Nexus delivers the OAuth client_id. -->
                <TextBlock x:Name="NexusConnectSublabel" TextWrapping="Wrap" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" Visibility="Collapsed" />

                <TextBlock x:Name="StatusText" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap" />

                <!-- Auto-check toggle. Polls Nexus by mod id on game load (debounced ~24h/game) to flag
                     mods with a newer version available. The manual "Refresh Nexus stats" action works
                     regardless of this setting. -->
                <CheckBox AutomationProperties.AutomationId="AutoCheckModUpdatesCheck" x:Name="AutoCheckModUpdatesCheck"
                          Content="Check for mod updates automatically"
                          Click="OnAutoCheckModUpdatesToggled"
                          ToolTipService.ToolTip="On game load, quietly check Nexus for newer versions of your installed mods (about once a day per game). The manual Refresh Nexus stats action always works." />

                <!-- Keep-plugins-updated toggle. Gates the 24h re-check of the plugin feed (the first
                     install on Nexus connect always fires regardless). Desktop (FULL) only — the STORE
                     build shows a static note because plugins are a desktop-only delivery channel. -->
                <CheckBox AutomationProperties.AutomationId="KeepPluginsUpdatedCheck" x:Name="KeepPluginsUpdatedCheck"
                          Content="Keep plugins updated"
                          Click="OnKeepPluginsUpdatedToggled"
                          ToolTipService.ToolTip="Once a day, quietly fetch the latest signed Nexus plugin from the 626 Mod Launcher feed. The first install always runs on connect; this gates the daily re-check." />
                <TextBlock x:Name="PluginStatusText" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" />
                <!-- Manual install / refresh button — FULL only. On STORE the PluginStatusText already
                     shows "Plugins are a desktop-only feature." and this button is absent from the tree.
                     The x:Name is referenced in the code-behind; the code-behind #if FULL guards it. -->
                <Button AutomationProperties.AutomationId="RefreshPluginButton" x:Name="RefreshPluginButton"
                        Content="Install / refresh Nexus plugin"
                        Click="OnRefreshPlugin"
                        Margin="0,4,0,0" />
            </StackPanel>

            <!-- Divider -->
            <Border BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Margin="0,8,0,0" />

            <!-- ============ Back up everything ============
                 Filed beside Restore points and above Danger, for the same reason they are: this is a
                 backup, not a risk. Restore points are this machine's undo; an archive is the one you
                 can carry away. Both are the opposite of the section below them. -->
            <StackPanel AutomationProperties.AutomationId="SettingsGroup.archive"
                        AutomationProperties.Name="Back up everything" Spacing="{StaticResource SpaceM}">
                <TextBlock Text="Back up everything" FontWeight="SemiBold" FontSize="{StaticResource RowTitleFontSize}" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}"
                           Text="One file holding every game's mods, saves and settings — for moving to a new PC, or just keeping somewhere safe. Nothing on this machine is changed." />
                <CheckBox AutomationProperties.AutomationId="ArchiveIncludeHistoryCheck" x:Name="ArchiveIncludeHistoryCheck"
                          Content="Include snapshot history"
                          ToolTipService.ToolTip="Your per-game backups and restore points. Usually the largest part of the archive by far, and rarely what you need on a new machine." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button AutomationProperties.AutomationId="ArchiveCreateButton" x:Name="ArchiveCreateButton"
                            Content="Back up everything…" Click="OnCreateProfileArchive" />
                    <!-- Reading is a separate act from writing, and there is deliberately no restore
                         button next to it yet: this screen exists to answer "what is in this thing?" -->
                    <Button AutomationProperties.AutomationId="ArchiveInspectButton" x:Name="ArchiveInspectButton"
                            Content="Look inside a backup…" Click="OnInspectProfileArchive"
                            ToolTipService.ToolTip="Open a backup file and see what it holds. Nothing is restored." />
                </StackPanel>
                <TextBlock x:Name="ArchiveStatusText" AutomationProperties.AutomationId="ArchiveStatusText"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>

            <Border BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Margin="0,8,0,0" />

            <!-- ============ Restore points ============ -->
            <StackPanel AutomationProperties.AutomationId="SettingsGroup.restore"
                        AutomationProperties.Name="Restore points" Spacing="{StaticResource SpaceM}">
                <TextBlock Text="Restore points" FontWeight="SemiBold" FontSize="{StaticResource RowTitleFontSize}" />
                <!-- ============ RESTORE POINTS ============ -->
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}"
                           Text="Snapshots of your launcher state created before a reset. Restore to bring back a previous setup, or delete what you no longer need." />
                <TextBlock x:Name="NoRestorePointsText" Text="No restore points yet."
                           Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" Visibility="Collapsed" />
                <ItemsRepeater x:Name="RestorePointsList">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:RestorePointRow">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Foreground="{StaticResource ThemeInk}" Text="{x:Bind Timestamp}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Detail}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button AutomationProperties.Name="{x:Bind RestoreAutomationName}" Grid.Column="1" Content="Restore" Tag="{x:Bind Id}"
                                        Click="OnRestorePoint" VerticalAlignment="Center" />
                                <Button AutomationProperties.Name="{x:Bind DeleteAutomationName}" Grid.Column="2" Content="Delete" Tag="{x:Bind Id}"
                                        Click="OnDeleteRestorePoint" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- Divider -->
            <Border BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Margin="0,8,0,0" />

            <!-- ============ Reset ============ -->
            <StackPanel AutomationProperties.AutomationId="SettingsGroup.reset"
                        AutomationProperties.Name="Reset" Spacing="{StaticResource SpaceM}">
                <TextBlock Text="Reset" FontWeight="SemiBold" FontSize="{StaticResource RowTitleFontSize}" />
                <!-- ============ RESET ============ -->
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}"
                           Text="Archive your current setup to a restore point, then reset the launcher to first-run. Your mods stay on disk." />
                <Button AutomationProperties.AutomationId="ResetLauncherButton" x:Name="ResetLauncherButton"
                        Content="Reset launcher…"
                        Click="OnResetLauncher" />
            </StackPanel>

            <!-- Divider -->
            <Border BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Margin="0,8,0,0" />

            <!-- About is a footer now. It was the fourth of nine headings; nobody opens Settings to
                 read attribution, and it was above three things they might have wanted. -->
            <StackPanel AutomationProperties.AutomationId="SettingsFooter"
                        AutomationProperties.Name="About" Spacing="4" Margin="0,8,0,0">
                <TextBlock Text="About" FontWeight="SemiBold" FontSize="{StaticResource BodyFontSize}"
                           Foreground="{StaticResource ThemeInkSoft}" />
                <!-- ============ ABOUT ============ -->
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}" Margin="0,8,0,0">
                    <Run Text="Save editor format work based on community reverse-engineering. Credit to: " />
                    <Hyperlink NavigateUri="https://github.com/BenGrn/EldenRingSaveCopier">
                        <Run Text="BenGrn/EldenRingSaveCopier" />
                    </Hyperlink>
                    <Run Text=" (MIT), " />
                    <Hyperlink NavigateUri="https://github.com/ClayAmore/ER-Save-Editor">
                        <Run Text="ClayAmore/ER-Save-Editor" />
                    </Hyperlink>
                    <Run Text=" (Apache-2.0), " />
                    <Hyperlink NavigateUri="https://github.com/alfizari/Elden-Ring-Save-Editor">
                        <Run Text="alfizari/Elden-Ring-Save-Editor" />
                    </Hyperlink>
                    <Run Text=" (MIT). Full license texts in THIRD_PARTY_NOTICES.md." />
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
