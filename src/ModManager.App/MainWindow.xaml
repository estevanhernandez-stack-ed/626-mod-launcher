<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ModManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ModManager.App.ViewModels"
    xmlns:tools="using:ModManager.App.Tools"
    xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
          RequestedTheme="Dark" Background="{StaticResource ThemeBg}">
        <!-- Keyboard access (F-025): the shell's three verbs get accelerators. Handlers no-op
             (and leave the key unhandled) when the surface isn't present, so Esc and Ctrl+F/R
             never steal from dialogs or the library home. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFilterAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar (custom, draggable). Last column reserves the caption-button inset so the
             interactive controls never sit under the system min/max/close buttons. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="12,0" ColumnSpacing="12"
              Background="{StaticResource ThemeTitleBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Width="20" Height="20" Source="{x:Bind ViewModel.AppIconSource, Mode=OneWay}" />
                <TextBlock Text="626 Mod Launcher" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="GameTitleControls" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" Visibility="Collapsed">
                <!-- Game-context title controls — shown only in a game's mod view, hidden on the Library
                     home (MainWindow toggles this in ShowLibrary / HideLibraryForGame). Home returns to
                     the library (which IS the game switcher); the label shows the game you're managing. -->
                <Button AutomationProperties.Name="Home" x:Name="HomeButton" Click="OnGoHome" Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center" ToolTipService.ToolTip="Back to your library">
                    <FontIcon Glyph="&#xE80F;" FontSize="{StaticResource RowTitleFontSize}" />
                </Button>
                <!-- Game switcher: pick another game without a Home round-trip. Selecting sets ActiveGame
                     (TwoWay) -> OnActiveGameChanged -> reload; the Home button still opens the full library. -->
                <ComboBox ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.ActiveGame, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          VerticalAlignment="Center" Margin="4,0,8,0" MinWidth="180" MaxWidth="320"
                          ToolTipService.ToolTip="Switch game" />
                <Button ToolTipService.ToolTip="Game options — find mods, fetch metadata, generate a theme, more"
                        Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE712;" FontSize="{StaticResource RowTitleFontSize}" />
                        <TextBlock Text="More" Foreground="{StaticResource ThemeInkSoft}" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <!-- Settings moved out to an always-visible title-bar gear (app-level, not
                                 game-scoped) so it's reachable from the Library home too.
                                 Find mods on Nexus / CurseForge moved out of this menu into the MODS
                                 toolbar section (Find mods dropdown) — they're discovery actions, not
                                 game-options. The handler OnFindMods reads Tag and is reused there. -->
                            <MenuFlyoutItem Text="Backfill metadata from Nexus archives…" Click="OnNexusBackfill"
                                            ToolTipService.ToolTip="Point at your folder of downloaded Nexus .zip archives to fill metadata for installed mods">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE896;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Identify loose mods on Nexus…" Click="OnLooseIdentify"
                                            Visibility="{x:Bind ViewModel.LooseIdentifyVisibility, Mode=OneWay}"
                                            ToolTipService.ToolTip="Name-search Nexus for unidentified loose files — you review every match before anything is saved">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE721;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Re-scan mods &amp; launchers" Click="OnRedetect">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Find existing mods…" Click="OnFindExistingMods"
                                            ToolTipService.ToolTip="Sweep this game's folder for mods you installed by hand — review before anything is added, nothing is moved">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE773;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Fetch metadata for all mods" Command="{x:Bind ViewModel.FetchMetadataCommand}"
                                            ToolTipService.ToolTip="Re-fetch metadata from CurseForge for every mod (best-effort).">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8F1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <!-- 'Generate a theme with AI' moved into the THEME dropdown ("+ New theme…")
                                 so theme-related actions live in one place. -->
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Remove this game…" Click="OnRemoveGame">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!-- App-level Settings — always visible (home + game view), since it's app-global, not
                     game-scoped. Pulled out of the game "More" flyout so the home can reach it too. -->
                <Button AutomationProperties.Name="Settings" Click="OnSettings" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="App settings — avatar / theme / window transparency / Nexus account">
                    <FontIcon Glyph="&#xE713;" FontSize="{StaticResource RowTitleFontSize}" />
                </Button>
                <Button Content="+ Game" Click="OnAddGame" />
            </StackPanel>
            <!-- The primary action is a sanctioned glow surface (F-002): the empty Border hosts the
                 composition bloom BEHIND the button — see Bloom.Attach in the code-behind. -->
            <Grid Grid.Column="4" VerticalAlignment="Center">
                <Border x:Name="LaunchBloomHost" />
                <SplitButton x:Name="LaunchSplitButton" Visibility="Collapsed"
                             Content="{x:Bind ViewModel.LaunchButtonLabel, Mode=OneWay}"
                             Command="{x:Bind ViewModel.LaunchCommand}"
                             ToolTipService.ToolTip="Click to run the target shown — open the menu to switch between modded / vanilla / alt launchers"
                             Foreground="{StaticResource ThemeBg}" Background="{StaticResource ThemeAccent}">
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="Bottom" Opening="OnLaunchMenuOpening" />
                    </SplitButton.Flyout>
                </SplitButton>
            </Grid>
        </Grid>

        <!-- Command bar -->
        <Grid Grid.Row="1" Padding="12,6" Background="{StaticResource ThemeBarBg}"
              BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Left cluster: three self-sizing sections (MODS / LOADOUT / LIBRARY). Each section is
                 a vertical StackPanel with the label on top and the button row below - the section
                 auto-sizes to MAX(label-width, button-row-width), so labels cannot drift out of
                 alignment with their cluster. Dividers sit between sections, bottom-anchored to
                 align with the button row (not stretching up through the label area). -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0"
                        Visibility="{x:Bind ViewModel.NormalBarVisibility, Mode=OneWay}">
                <!-- MODS: bulk toggle + intake. Find mods opens Nexus/CurseForge search in the browser
                     (discovery action — the user goes OUT to find mods, then comes back to drop or
                     + Add them locally). -->
                <StackPanel Orientation="Vertical" Spacing="2">
                    <TextBlock Text="MODS" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource TagFontSize}" FontFamily="{StaticResource StencilFontFamily}" FontStretch="Condensed" FontWeight="SemiBold" CharacterSpacing="80" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Enable all" Command="{x:Bind ViewModel.AllOnCommand}" />
                        <Button Content="Disable all" Command="{x:Bind ViewModel.AllOffCommand}" />
                        <!-- Browse Nexus is a first-class action, not a menu entry: it is the primary way to
                             discover mods now, so it gets its own accent button (same primary treatment as
                             Apply order / Launch options). It was buried in the Find mods flyout, which is
                             about opening a BROWSER — wrong home, and two clicks deep. Gated on
                             CatalogVisibility so it is absent on Store / no plugin / no domain / disconnected;
                             the handler picks the rich storefront or the older simple dialog by capability. -->
                        <Button Click="OnBrowseNexusInApp"
                                Visibility="{x:Bind ViewModel.CatalogVisibility, Mode=OneWay}"
                                Foreground="{StaticResource ThemeAccent}" Background="Transparent" BorderBrush="{StaticResource ThemeAccent}" BorderThickness="1"
                                ToolTipService.ToolTip="Browse this game's Nexus mods in the launcher — sorted, filterable, and marked with what you already have. Get opens the mod page to download.">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE721;" FontSize="{StaticResource BodyFontSize}" />
                                <TextBlock Text="Browse Nexus" Foreground="{StaticResource ThemeAccent}" />
                            </StackPanel>
                        </Button>
                        <DropDownButton ToolTipService.ToolTip="Open Nexus Mods or CurseForge in your browser, searched for this game">
                            <DropDownButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE721;" FontSize="{StaticResource BodyFontSize}" />
                                    <TextBlock Text="Find mods" />
                                </StackPanel>
                            </DropDownButton.Content>
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Find mods on Nexus Mods" Tag="nexus" Click="OnFindMods">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE721;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Find mods on CurseForge" Tag="curseforge" Click="OnFindMods">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE721;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button Content="+ Add mods" Click="OnAddMods" />
                        <!-- TwoWay so a VM-side clear (game switch, no-game reset) empties the BOX
                             too — a one-way box->VM flow left stale text stating a filter that
                             wasn't applied (B4.5 review catch). -->
                        <TextBox x:Name="ModFilterBox" Width="170" PlaceholderText="Filter mods…"
                                 Text="{x:Bind ViewModel.ModFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 ToolTipService.ToolTip="Narrow the list by mod name, author, or file key" />
                    </StackPanel>
                </StackPanel>
                <shapes:Rectangle Width="1" Height="32" Fill="{StaticResource ThemeBorder}"
                                  VerticalAlignment="Bottom" Margin="10,0,10,0" />
                <!-- LOADOUT: All / MP / SP filter (segmented) -->
                <StackPanel Orientation="Vertical" Spacing="2">
                    <TextBlock Text="LOADOUT" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource TagFontSize}" FontFamily="{StaticResource StencilFontFamily}" FontStretch="Condensed" FontWeight="SemiBold" CharacterSpacing="80" />
                    <Border CornerRadius="0" BorderThickness="1" BorderBrush="{StaticResource ThemeBorder}"
                            Background="{StaticResource ThemePanel}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Active nav is a sanctioned glow surface (F-077): each segment carries a
                                 bloom host behind it, lit only while that segment's fill is the accent
                                 (wired in the ctor via Bloom.AttachStateGlow on BackgroundProperty). -->
                            <Grid>
                                <Border x:Name="LoadoutAllGlowHost" />
                                <Button x:Name="LoadoutAllSegment" Content="All" Command="{x:Bind ViewModel.SetModeCommand}" CommandParameter="all"
                                        BorderThickness="0" CornerRadius="0" MinWidth="44"
                                        Background="{x:Bind ViewModel.LoadoutAllBrush, Mode=OneWay}"
                                        Foreground="{x:Bind ViewModel.LoadoutAllForeground, Mode=OneWay}" />
                            </Grid>
                            <shapes:Rectangle Width="1" Fill="{StaticResource ThemeBorder}" />
                            <Grid>
                                <Border x:Name="LoadoutMpGlowHost" />
                                <Button x:Name="LoadoutMpSegment" Content="MP"  Command="{x:Bind ViewModel.SetModeCommand}" CommandParameter="mp"
                                        BorderThickness="0" CornerRadius="0" MinWidth="44"
                                        Background="{x:Bind ViewModel.LoadoutMpBrush, Mode=OneWay}"
                                        Foreground="{x:Bind ViewModel.LoadoutMpForeground, Mode=OneWay}" />
                            </Grid>
                            <shapes:Rectangle Width="1" Fill="{StaticResource ThemeBorder}" />
                            <Grid>
                                <Border x:Name="LoadoutSpGlowHost" />
                                <Button x:Name="LoadoutSpSegment" Content="SP"  Command="{x:Bind ViewModel.SetModeCommand}" CommandParameter="sp"
                                        BorderThickness="0" CornerRadius="0" MinWidth="44"
                                        Background="{x:Bind ViewModel.LoadoutSpBrush, Mode=OneWay}"
                                        Foreground="{x:Bind ViewModel.LoadoutSpForeground, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <shapes:Rectangle Width="1" Height="32" Fill="{StaticResource ThemeBorder}"
                                  VerticalAlignment="Bottom" Margin="10,0,10,0" />
                <!-- LIBRARY: rescan + reorder + saved-state surfaces -->
                <StackPanel Orientation="Vertical" Spacing="2">
                    <TextBlock Text="LIBRARY" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource TagFontSize}" FontFamily="{StaticResource StencilFontFamily}" FontStretch="Condensed" FontWeight="SemiBold" CharacterSpacing="80" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="↻ Refresh" Command="{x:Bind ViewModel.RefreshCommand}"
                                ToolTipService.ToolTip="Re-scan the game folder for mod changes, and refresh Nexus stats (endorsements, downloads, update flags) when connected" />
                        <Button Content="Reorder" Click="OnUnlockLoadOrder" ToolTipService.ToolTip="Drag rows to set the load order" />
                        <Button Content="Profiles" Click="OnProfiles" ToolTipService.ToolTip="Saved loadouts" />
                        <Button Content="Saves" Click="OnSaves" ToolTipService.ToolTip="Save snapshots + installed save mods" />
                    </StackPanel>
                </StackPanel>
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18" Foreground="{StaticResource ThemeAccent}"
                              VerticalAlignment="Bottom" Margin="10,0,0,6" />
                <!-- Only appears for a long, stoppable run (the Nexus name-search sweep). Quick
                     atomic file ops stay uninterruptible — see MainViewModel.IsCancellable. -->
                <Button Content="Stop" Click="OnCancelLongOperation"
                        Visibility="{x:Bind ViewModel.CancelVisibility, Mode=OneWay}"
                        VerticalAlignment="Bottom" Margin="8,0,0,2" Padding="10,2"
                        ToolTipService.ToolTip="Stop searching. Anything already found is kept for review." />
            </StackPanel>

            <!-- Load-order mode: reorder controls replace the normal bar -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.LoadOrderVisibility, Mode=OneWay}">
                <FontIcon Glyph="&#xE8CB;" FontSize="{StaticResource RowTitleFontSize}" Foreground="{StaticResource ThemeAccent}" />
                <TextBlock Text="Load order — drag rows or type a position." VerticalAlignment="Center" />
                <Button Content="Apply order" Click="OnApplyOrder" Foreground="{StaticResource ThemeAccent}" Background="Transparent" BorderBrush="{StaticResource ThemeAccent}" BorderThickness="1" />
                <Button Content="Cancel" Click="OnCancelOrder" />
            </StackPanel>
            <!-- Right cluster: VIEW (group-by) · SETTINGS (theme picker) · standalone Nexus indicator.
                 Informational widgets (CoopHint / MpWarning / LaunchHint) sit at the left edge of this
                 stack and don't belong to any labeled section - they're visibility-toggled status banners.
                 Nexus has no section label - its dot color (accent / danger) signals the state. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Bottom">
                <Button Click="OnCoopHint" Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom"
                        ToolTipService.ToolTip="Seamless Co-op is installed but its launcher is missing — co-op needs the full mod"
                        Visibility="{x:Bind ViewModel.CoopHintVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE7BA;" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource ThemeDanger}" />
                        <TextBlock Text="Co-op needs its launcher" Foreground="{StaticResource ThemeDanger}" />
                    </StackPanel>
                </Button>
                <Border Padding="8,2" CornerRadius="0" VerticalAlignment="Bottom" Margin="6,0,0,0"
                        ToolTipService.ToolTip="Some enabled mods may desync co-op — review before hosting or joining"
                        Visibility="{x:Bind ViewModel.MpWarningVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7BA;" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource ThemeDanger}" />
                        <TextBlock AutomationProperties.HelpText="Some enabled mods may desync co-op — review before hosting or joining" Text="{x:Bind ViewModel.MpWarningText, Mode=OneWay}"
                                   Foreground="{StaticResource ThemeDanger}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <!-- Ban-risk banner: game-level anti-cheat exposure, distinct from the per-mod
                     co-op-desync warning above. Both can be visible at once; they must read as two
                     separate warnings. Stays up even after the enable gate is acked.
                     Danger alerts are a sanctioned glow surface (F-002), but a rect bloom behind
                     transparent danger text read red-on-red (Este's call) — the host now sits
                     behind the TEXT and the shadow is glyph-masked: a slight drop shadow under
                     the letterforms. See Bloom.AttachTextShadow. -->
                <Grid VerticalAlignment="Bottom" Margin="6,0,0,0"
                      Visibility="{x:Bind ViewModel.BanRiskWarningVisibility, Mode=OneWay}">
                <Border x:Name="BanRiskBanner" Padding="8,2" CornerRadius="0"
                        ToolTipService.ToolTip="This game uses anti-cheat — modding for online play can get your account banned"
                        Visibility="{x:Bind ViewModel.BanRiskWarningVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7BA;" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource ThemeDanger}" />
                        <Grid>
                            <Border x:Name="BanRiskBloomHost" />
                            <TextBlock x:Name="BanRiskText" AutomationProperties.HelpText="This game uses anti-cheat — modding for online play can get your account banned" Text="{x:Bind ViewModel.BanRiskWarningText, Mode=OneWay}"
                                       Foreground="{StaticResource ThemeDanger}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
                </Grid>
                <Button Click="OnLaunchOptions" Foreground="{StaticResource ThemeAccent}" Background="Transparent" BorderBrush="{StaticResource ThemeAccent}" BorderThickness="1"
                        VerticalAlignment="Bottom" Margin="6,0,0,0"
                        ToolTipService.ToolTip="This game needs a launch option for mods to load"
                        Visibility="{x:Bind ViewModel.LaunchHintVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7BA;" FontSize="{StaticResource BodyFontSize}" />
                        <TextBlock Text="Launch options" Foreground="{StaticResource ThemeAccent}" />
                    </StackPanel>
                </Button>
                <!-- VIEW: how the mod list is grouped -->
                <StackPanel Orientation="Vertical" Spacing="2" Margin="10,0,0,0">
                    <TextBlock Text="VIEW" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource TagFontSize}" FontFamily="{StaticResource StencilFontFamily}" FontStretch="Condensed" FontWeight="SemiBold" CharacterSpacing="80" />
                    <ComboBox MinWidth="120" ToolTipService.ToolTip="Group the mod list"
                              ItemsSource="{x:Bind ViewModel.GroupModes}"
                              SelectedItem="{x:Bind ViewModel.GroupMode, Mode=TwoWay}" />
                </StackPanel>
                <shapes:Rectangle Width="1" Height="32" Fill="{StaticResource ThemeBorder}"
                                  VerticalAlignment="Bottom" Margin="10,0,10,0" />
                <!-- THEME: picker + generator in one dropdown. Selecting a theme applies it; the
                     "+ New theme…" item at the bottom of the flyout opens the AI theme generator. -->
                <StackPanel Orientation="Vertical" Spacing="2">
                    <TextBlock Text="THEME" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource TagFontSize}" FontFamily="{StaticResource StencilFontFamily}" FontStretch="Condensed" FontWeight="SemiBold" CharacterSpacing="80" />
                    <DropDownButton MinWidth="140" ToolTipService.ToolTip="Pick a theme or generate a new one">
                        <DropDownButton.Content>
                            <TextBlock Text="{x:Bind ViewModel.SelectedThemeName, Mode=OneWay}" />
                        </DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <MenuFlyout Opening="OnThemeMenuOpening" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
                <shapes:Rectangle Width="1" Height="32" Fill="{StaticResource ThemeBorder}"
                                  VerticalAlignment="Bottom" Margin="10,0,10,0" />
                <!-- Nexus ACCOUNT chip + jump-link. Clicking opens Settings (which owns the
                     connect/disconnect UI as its Nexus section). The dot is the affordance:
                     accent-green when connected, danger-red when not.

                     The label is bound, not the literal "Nexus", so this chip never reads as a repeat of
                     the Browse Nexus action button in the MODS group. Connected it shows the account name
                     (this chip is about WHO you are, not the brand); disconnected it reads "Connect Nexus",
                     and the Browse button is hidden in that state, so the two never collide. -->
                <Button Click="OnSettings" VerticalAlignment="Bottom"
                        ToolTipService.ToolTip="{x:Bind ViewModel.NexusChipTooltip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" Fill="{x:Bind ViewModel.NexusStatusBrush, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.NexusChipLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tools row: slim strip above the mod list. Installed tools render as buttons,
             catalog entries that apply but aren't installed render as "Get it here" chips,
             and a + button is always present for ad-hoc tool installs (Task 9 wires picker). -->
        <tools:ToolsPanel x:Name="ToolsRow" Grid.Row="2"
                          Visibility="{x:Bind ViewModel.ToolsRowVisible, Mode=OneWay}" />

        <!-- Mod list + Vortex banner -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Vortex-managed banners (owned + re-deployed). Stacked so both render cleanly if
                 both ever apply at once. Dismiss collapses the whole area for the session. -->
            <StackPanel x:Name="VortexBannerArea" Grid.Row="0">
                <!-- Owned folders not yet taken over -->
                <Border Visibility="{x:Bind ViewModel.OwnedBannerVisibility, Mode=OneWay}"
                        Background="{StaticResource ThemeBarBg}" BorderBrush="{StaticResource ThemeBorder}"
                        BorderThickness="0,0,0,1" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Some folders here are managed by Vortex." VerticalAlignment="Center" />
                        <Button Content="Take them over" Click="OnTakeOverGame" />
                        <Button Content="Dismiss" Click="OnDismissVortexBanner" />
                    </StackPanel>
                </Border>

                <!-- Taken over, but a Vortex marker came back -->
                <Border Visibility="{x:Bind ViewModel.ReDeployedBannerVisibility, Mode=OneWay}"
                        Background="{StaticResource ThemeBarBg}" BorderBrush="{StaticResource ThemeDanger}"
                        BorderThickness="0,0,0,1" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Vortex re-deployed into a folder you took over." VerticalAlignment="Center" />
                        <Button Content="Take over again" Click="OnTakeOverGame" />
                    </StackPanel>
                </Border>

                <!-- Steam updated this game since we last recorded its build — installed mods may need rechecking.
                     Dismiss ("Mark as rechecked") re-baselines to the live build via the view-model. -->
                <Border Visibility="{x:Bind ViewModel.SteamBuildWarningVisibility, Mode=OneWay}"
                        Background="{StaticResource ThemeBarBg}" BorderBrush="{StaticResource ThemeDanger}"
                        BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="{StaticResource RowTitleFontSize}" VerticalAlignment="Center"
                                  Foreground="{StaticResource ThemeDanger}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SteamBuildMessage, Mode=OneWay}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Mark as rechecked" VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.DismissBuildWarningCommand}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Mod list -->
            <ListView x:Name="ModListView" Grid.Row="1" Padding="8,4" KeyDown="OnModListKeyDown"
                  ItemsSource="{x:Bind ViewModel.Mods, Mode=OneWay}" SelectionMode="None"
                  CanReorderItems="{x:Bind ViewModel.IsLoadOrderMode, Mode=OneWay}"
                  CanDragItems="{x:Bind ViewModel.IsLoadOrderMode, Mode=OneWay}"
                  AllowDrop="{x:Bind ViewModel.IsLoadOrderMode, Mode=OneWay}"
                  DragItemsCompleted="OnReorderCompleted"
                  Visibility="{x:Bind ViewModel.GameVisibility, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ModRowViewModel">
                    <StackPanel>
                    <!-- Section header. Right-margin 4 (was 0 on the plain TextBlock) for visual consistency with the ? button column. -->
                    <Grid Visibility="{x:Bind SectionHeaderVisibility, Mode=OneWay}" Margin="4,16,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind SectionHeader}"
                                   FontWeight="SemiBold" FontSize="{StaticResource TagFontSize}" FontFamily="{StaticResource StencilFontFamily}" FontStretch="Condensed" CharacterSpacing="80"
                                   Foreground="{StaticResource ThemeAccent}" />
                        <Button Grid.Column="1" Click="OnShowChipGlossary" Padding="6,0" MinWidth="24" MinHeight="24"
                                Background="{StaticResource ThemePanel}" CornerRadius="0" BorderThickness="0"
                                ToolTipService.ToolTip="What do the chips and icons mean?"
                                Visibility="{x:Bind FirstSectionHelpVisibility, Mode=OneWay}">
                            <TextBlock Text="?" FontSize="{StaticResource MetaFontSize}" Foreground="{StaticResource ThemeAccent}" />
                        </Button>
                    </Grid>
                    <Grid Padding="{StaticResource RowPadding}" ColumnSpacing="12" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,0,0,1">
                        <!-- Columns: toggle / art / name(*) / chips / actions / uninstall (F-005). -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Match to a mod…" Click="OnManualMatch" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <!-- Toggle leads the row (design language row anatomy; vibe-glow F-005 — Este's call:
                             toggle first, art second). Declared FIRST as well as placed first: XAML tab order
                             and the UIA tree follow declaration order, and the toggle is the row's primary
                             affordance for keyboard and screen-reader users too.
                             The empty Border hosts the enabled-state bloom BEHIND the switch (F-077):
                             light means live — an ON toggle emits the accent glow. Wired in
                             OnRowToggleLoaded; recycle-safe (AttachStateGlow skips wired hosts). -->
                        <Grid Grid.Column="0">
                            <!-- Sized to the switch TRACK (40x20 in SquaredControls), not the
                                 control's layout box — the full-cell glow read as a weird box
                                 behind the toggle (Este's catch). Slightly shorter than the
                                 track so the halo hugs it. -->
                            <Border Width="40" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <ToggleSwitch IsOn="{x:Bind ToggleIsOn, Mode=OneWay}" Toggled="OnModToggled"
                                          Loaded="OnRowToggleLoaded"
                                          AutomationProperties.Name="{x:Bind ToggleAutomationName, Mode=OneWay}"
                                          IsEnabled="{x:Bind CanInteract, Mode=OneWay}"
                                          VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""
                                          Visibility="{x:Bind ToggleVisibility, Mode=OneWay}" />
                        </Grid>

                        <!-- Icon cell: load-order number (editable) in reorder mode, else art/monogram -->
                        <Grid Grid.Column="1" Width="48" Height="40" VerticalAlignment="Center">
                            <Border Background="{StaticResource ThemePanel}" CornerRadius="0"
                                    Visibility="{x:Bind MonogramVisibility, Mode=OneWay}">
                                <TextBlock Text="{x:Bind Initial}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource ThemeAccent}" />
                            </Border>
                            <Border CornerRadius="0" Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}">
                                <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                            </Border>
                            <NumberBox Value="{x:Bind OrderValue, Mode=OneWay}" ValueChanged="OnJump"
                                       SpinButtonPlacementMode="Hidden" VerticalAlignment="Center" Width="48"
                                       Visibility="{x:Bind OrderVisibility, Mode=OneWay}" />
                        </Grid>

                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Foreground="{StaticResource ThemeInk}" Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="{StaticResource RowTitleFontSize}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind FileTag}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MetaFontSize}" Foreground="{StaticResource ThemeInkMuted}"
                                           VerticalAlignment="Center" Visibility="{x:Bind FileTagVisibility}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Description}" Foreground="{StaticResource ThemeInkSoft}" TextWrapping="Wrap" MaxLines="2"
                                       Visibility="{x:Bind DescriptionVisibility}" />
                            <StackPanel Orientation="Horizontal" Spacing="2" Visibility="{x:Bind CreditVisibility}">
                                <TextBlock Text="{x:Bind AuthorText}" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center"
                                           Visibility="{x:Bind AuthorVisibility}" />
                                <HyperlinkButton Content="{x:Bind ModUrlLabel}" NavigateUri="{x:Bind ModUri}" Padding="6,0" FontSize="{StaticResource BodyFontSize}"
                                                 Visibility="{x:Bind ModUrlVisibility}" />
                                <HyperlinkButton Content="Source" NavigateUri="{x:Bind SourceUri}" Padding="6,0" FontSize="{StaticResource BodyFontSize}"
                                                 Visibility="{x:Bind SourceVisibility}" />
                                <HyperlinkButton Content="Donate" NavigateUri="{x:Bind DonateUri}" Padding="6,0" FontSize="{StaticResource BodyFontSize}"
                                                 Foreground="{StaticResource ThemeDanger}" Visibility="{x:Bind DonateVisibility}" />
                                <TextBlock Text="{x:Bind DownloadsText}" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center"
                                           Visibility="{x:Bind DownloadsVisibility}" />
                                <TextBlock Text="{x:Bind EndorsementsText}" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center"
                                           Visibility="{x:Bind EndorsementsVisibility}" />
                                <TextBlock Text="Removed from Nexus" Foreground="{StaticResource ThemeDanger}" FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center"
                                           Visibility="{x:Bind RemovedFromNexusVisibility}" />
                            </StackPanel>
                            <!-- Multi-variant family: pick which level(s) to run, inline on this one row -->
                            <ItemsControl ItemsSource="{x:Bind VariantOptions}" Margin="0,4,0,0"
                                          Visibility="{x:Bind VariantOptionsVisibility, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VariantOptionVM">
                                        <ToggleButton Content="{x:Bind Label}" IsChecked="{x:Bind Enabled, Mode=OneWay}"
                                                      IsEnabled="{x:Bind CanToggle}" Click="OnVariantClick"
                                                      MinWidth="0" Padding="10,2" FontSize="{StaticResource BodyFontSize}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Same mod, different levels — pick one (turning one on turns the others off). Drop in more anytime; they won't collide."
                                       Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource MetaFontSize}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{x:Bind VariantOptionsVisibility, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <HyperlinkButton NavigateUri="{x:Bind MissingFrameworkUri, Mode=OneWay}"
                                             Padding="0" BorderThickness="0" Background="Transparent"
                                             Visibility="{x:Bind MissingFrameworkVisibility, Mode=OneWay}"
                                             ToolTipService.ToolTip="{x:Bind MissingFrameworkNote, Mode=OneWay}">
                                <Border CornerRadius="0" Padding="6,2"
                                        BorderThickness="1" BorderBrush="{x:Bind MissingFrameworkBrush, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind MissingFrameworkChip, Mode=OneWay}"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MetaFontSize}"
                                               Foreground="{x:Bind MissingFrameworkBrush, Mode=OneWay}" />
                                </Border>
                            </HyperlinkButton>
                            <Border CornerRadius="0" Padding="6,2" Background="{StaticResource ThemePanel}"
                                    BorderThickness="1" BorderBrush="{StaticResource ThemeInkSoft}"
                                    ToolTipService.ToolTip="Managed by another mod tool — shown read-only here"
                                    Visibility="{x:Bind ManagedVisibility, Mode=OneWay}">
                                <TextBlock AutomationProperties.HelpText="Managed by another mod tool — shown read-only here" Text="{x:Bind ManagedBadge}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MetaFontSize}" Foreground="{StaticResource ThemeInkSoft}" />
                            </Border>
                            <Border CornerRadius="0" Padding="6,2" Background="{StaticResource ThemePanel}"
                                    BorderThickness="1" BorderBrush="{StaticResource ThemeInkSoft}"
                                    ToolTipService.ToolTip="Ships with UE4SS — framework mod, not a downloaded mod"
                                    Visibility="{x:Bind BuiltinVisibility, Mode=OneWay}">
                                <TextBlock AutomationProperties.HelpText="Ships with UE4SS — framework mod, not a downloaded mod" Text="UE4SS BUILT-IN" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MetaFontSize}" Foreground="{StaticResource ThemeInkSoft}" />
                            </Border>
                            <Border CornerRadius="0" Padding="6,2" Background="Transparent" BorderBrush="{StaticResource ThemeAccent}" BorderThickness="1"
                                    ToolTipService.ToolTip="The mod loader (dinput8.dll) — toggling it turns the whole modded setup off or on"
                                    Visibility="{x:Bind LoaderChipVisibility, Mode=OneWay}">
                                <TextBlock AutomationProperties.HelpText="The mod loader (dinput8.dll) — toggling it turns the whole modded setup off or on" Text="LOADER" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MetaFontSize}" Foreground="{StaticResource ThemeAccent}" />
                            </Border>
                            <Border CornerRadius="0" Padding="6,2" Background="Transparent" BorderBrush="{StaticResource ThemeAccent}" BorderThickness="1"
                                    ToolTipService.ToolTip="{x:Bind UpdateTooltip}"
                                    Visibility="{x:Bind UpdateAvailableVisibility}">
                                <TextBlock AutomationProperties.HelpText="{x:Bind UpdateTooltip}" Text="UPDATE" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MetaFontSize}" Foreground="{StaticResource ThemeAccent}" />
                            </Border>
                            <Border CornerRadius="0" Padding="6,2" Background="Transparent" BorderBrush="{StaticResource ThemeAccent}" BorderThickness="1"
                                    ToolTipService.ToolTip="One of several variants of the same mod — toggle whichever you want"
                                    Visibility="{x:Bind VariantGroupVisibility, Mode=OneWay}">
                                <TextBlock AutomationProperties.HelpText="One of several variants of the same mod — toggle whichever you want" Text="VARIANT" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MetaFontSize}" Foreground="{StaticResource ThemeAccent}" />
                            </Border>
                            <Border Background="{StaticResource ThemePanel}" CornerRadius="0" Padding="6,2"
                                    ToolTipService.ToolTip="{x:Bind ClassChipTooltip}">
                                <TextBlock AutomationProperties.HelpText="{x:Bind ClassChipTooltip}" Foreground="{StaticResource ThemeInk}" Text="{x:Bind ClassChip}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MetaFontSize}" />
                            </Border>
                            <Border Background="{StaticResource ThemePanel}" CornerRadius="0" Padding="6,2"
                                    Visibility="{x:Bind VariantVisibility}"
                                    ToolTipService.ToolTip="Active variant of this mod. Click another in the family to switch.">
                                <TextBlock AutomationProperties.HelpText="Active variant of this mod. Click another in the family to switch." Foreground="{StaticResource ThemeInk}" Text="{x:Bind VariantChip}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MetaFontSize}" />
                            </Border>
                            <!-- MP-safety badge doubles as the set-override affordance (faint "MP?" = no claim) -->
                            <Button Padding="6,2" CornerRadius="0" BorderThickness="0" MinHeight="24" MinWidth="24"
                                    Background="{StaticResource ThemePanel}" VerticalAlignment="Center"
                                    Opacity="{x:Bind MpBadgeOpacity, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind MpBadgeTooltip, Mode=OneWay}">
                                <TextBlock Text="{x:Bind MpBadge, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MetaFontSize}"
                                           Foreground="{x:Bind MpBadgeBrush, Mode=OneWay}" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Mark MP-safe" Click="OnSetMpCompat" Tag="Safe" />
                                        <MenuFlyoutItem Text="Mark MP-risky" Click="OnSetMpCompat" Tag="Risky" />
                                        <MenuFlyoutItem Text="Mark SP-only" Click="OnSetMpCompat" Tag="SpOnly" />
                                        <MenuFlyoutItem Text="Auto (clear)" Click="OnSetMpCompat" Tag="Auto" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <!-- Endorse heart: only on Nexus-identified rows while connected. OneWay so the
                                 heart flips in place after a toggle. Refusals/rate-limit go to the status line. -->
                            <Button AutomationProperties.Name="{x:Bind EndorseAutomationName}" Click="OnEndorse" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind EndorseTooltip, Mode=OneWay}"
                                    Visibility="{x:Bind EndorseVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="0">
                                    <FontIcon Glyph="{x:Bind EndorseGlyph, Mode=OneWay}" FontSize="{StaticResource RowTitleFontSize}"
                                              HorizontalAlignment="Center" Foreground="{StaticResource ThemeAccent}" />
                                    <TextBlock Text="endorse" FontSize="{StaticResource TagFontSize}" Foreground="{StaticResource ThemeInkSoft}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{x:Bind ReadmeAutomationName}" Click="OnShowReadme" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="Readme"
                                    Visibility="{x:Bind ReadmeVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="0">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="{StaticResource RowTitleFontSize}" HorizontalAlignment="Center" />
                                    <TextBlock Text="readme" FontSize="{StaticResource TagFontSize}" Foreground="{StaticResource ThemeInkSoft}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{x:Bind ConfigAutomationName}" Click="OnShowCockpit" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="Config cockpit — edit settings, view keybinds &amp; commands"
                                    Visibility="{x:Bind CockpitVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="0">
                                    <FontIcon Glyph="&#xE713;" FontSize="{StaticResource RowTitleFontSize}" HorizontalAlignment="Center" />
                                    <TextBlock Text="config" FontSize="{StaticResource TagFontSize}" Foreground="{StaticResource ThemeInkSoft}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="{x:Bind IniAutomationName}" Click="OnEditIniClick" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="Edit INI files in this mod (snapshots before save)"
                                    Visibility="{x:Bind IniIconVisibility, Mode=OneWay}"
                                    Tag="{x:Bind}">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="0">
                                    <SymbolIcon Symbol="Edit" />
                                    <TextBlock Text="INI" FontSize="{StaticResource TagFontSize}" Foreground="{StaticResource ThemeInkSoft}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button AutomationProperties.Name="{x:Bind UninstallAutomationName}" Grid.Column="5" Click="OnUninstall" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Uninstall (permanent)"
                                Visibility="{x:Bind ManageVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="0">
                                <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource RowTitleFontSize}" Foreground="{StaticResource ThemeDanger}" HorizontalAlignment="Center" />
                                <TextBlock Text="uninstall" FontSize="{StaticResource TagFontSize}" Foreground="{StaticResource ThemeInkSoft}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Empty state -->
        <TextBlock Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ThemeInkDim}"
                   Text="No game registered yet. Add one with + Game."
                   Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />

        <!-- Zero-match filter state (F-059): a blank list reads as broken — name the query. -->
        <TextBlock Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ThemeInkDim}"
                   Text="{x:Bind ViewModel.FilterEmptyText, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.FilterEmptyVisibility, Mode=OneWay}" />

        <!-- Status bar -->
        <Grid Grid.Row="4" Height="32" Padding="12,0" Background="{StaticResource ThemeFooterBg}"
              BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Open-in-Explorer affordance — a quiet folder glyph that fires the game-root path
                 through the shell. Hidden when no game is active so the empty footer stays clean. -->
            <Button Grid.Column="0" AutomationProperties.Name="Open game folder" Click="OnOpenGameFolder"
                    Background="Transparent" BorderThickness="0" Padding="0,0,8,0" MinWidth="0"
                    ToolTipService.ToolTip="Open game folder in Explorer"
                    Visibility="{x:Bind ViewModel.GameVisibility, Mode=OneWay}">
                <FontIcon Glyph="&#xE838;" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource ThemeInkSoft}" />
            </Button>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.GameRootText, Mode=OneWay}" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="AppStatusText" Grid.Column="2" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}"
                       AutomationProperties.LiveSetting="Polite"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Library home overlay. Sits above the game view and spans the whole content area below the
             title bar (row 1..4). The app lands here; Open/Manage swaps to the game view (collapse),
             Home returns (show + reload). The title-bar switcher stays live behind it for quick
             in-context switching once inside a game. -->
        <Grid x:Name="LibraryHost" Grid.Row="1" Grid.RowSpan="4" Background="{StaticResource ThemeBg}" />

        <!-- Nexus storefront overlay. Same host pattern as LibraryHost: a full-size surface over the
             content area, because a card grid with filters needs the room a ContentDialog can't give.
             Populated on demand (MainWindow.ShowCatalog) and emptied on close so the page's thumbnails
             are released. Hidden at rest. -->
        <Grid x:Name="CatalogHost" Grid.Row="1" Grid.RowSpan="4" Background="{StaticResource ThemeBg}"
              Visibility="Collapsed" />

        <!-- Cross-game Updates overlay. Same host pattern again: opened from the Library home, emptied
             on Back so the snapshot it was built from can't go stale behind a hidden view. Renders from
             persisted metadata only — nothing in here makes a network call. -->
        <Grid x:Name="UpdatesHost" Grid.Row="1" Grid.RowSpan="4" Background="{StaticResource ThemeBg}"
              Visibility="Collapsed" />
    </Grid>
</Window>
