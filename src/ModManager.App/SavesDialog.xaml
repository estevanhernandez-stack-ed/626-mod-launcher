<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModManager.App.SavesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModManager.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CloseButtonText="Close"
    DefaultButton="Close"
    AutomationProperties.Name="Save snapshots">

    <!-- Dialog shell (vibe-glow F-008): 3px accent rail + mono-caps stencil eyebrow + title,
         per the design language's dialog rules. Rail bleeds toward the dialog edges. -->
    <ContentDialog.Title>
        <StackPanel Spacing="6">
            <Border Height="3" Background="{StaticResource ThemeAccent}" Margin="-24,0,-24,4"
                    AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="SAVES // SNAPSHOT-GUARDED" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.AccessibilityView="Raw"
                       FontSize="{StaticResource TagFontSize}" CharacterSpacing="80"
                       Foreground="{StaticResource ThemeInkDim}" />
            <TextBlock Text="Save snapshots" FontSize="{StaticResource ViewTitleFontSize}" FontWeight="SemiBold" />
        </StackPanel>
    </ContentDialog.Title>


    <!-- Scroll wrapper: the dialog clips silently when content outgrows the window
         (the snapshot list was cutting mid-row) — same pattern as SettingsDialog. -->
    <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" Width="480">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox AutomationProperties.AutomationId="SavesFolderBox" x:Name="FolderBox" Grid.Column="0" Header="Save folder" IsReadOnly="True"
                     PlaceholderText="Set the game's save folder to enable snapshots" />
            <Button AutomationProperties.AutomationId="OpenSaveFolderButton" AutomationProperties.Name="Open save folder" x:Name="OpenFolderButton" Grid.Column="1" Click="OnOpenSaveFolder" VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="Open save folder in Explorer">
                <FontIcon Glyph="&#xE838;" FontSize="{StaticResource BodyFontSize}" />
            </Button>
            <Button AutomationProperties.AutomationId="ChangeSaveFolderButton" Grid.Column="2" Content="Change…" VerticalAlignment="Bottom" Click="OnChangeFolder" />
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox AutomationProperties.AutomationId="SnapshotLabelBox" x:Name="LabelBox" Grid.Column="0" Header="Label (optional)" PlaceholderText="e.g. before raid" />
            <Button AutomationProperties.AutomationId="BackupNowButton" x:Name="BackupButton" Grid.Column="1" Content="Back up now" VerticalAlignment="Bottom" Click="OnBackup" />
        </Grid>

        <!-- Moving a save to another machine. A snapshot lives here and belongs to this PC; a bundle
             is made to leave, which is why it is a separate pair of controls and not another button on
             the snapshot row. See docs/superpowers/plans/2026-08-20-save-transport-and-the-data-it-needs.md. -->
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button AutomationProperties.AutomationId="SaveBundleExportButton" x:Name="ExportBundleButton"
                    Content="Move to another PC…" Click="OnExportBundle"
                    ToolTipService.ToolTip="Pack this save, and the list of mods it was made with, into one file" />
            <Button AutomationProperties.AutomationId="SaveBundleImportButton" x:Name="ImportBundleButton"
                    Content="Bring a save in…" Click="OnImportBundle"
                    ToolTipService.ToolTip="Restore a save packed on another machine" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <CheckBox AutomationProperties.AutomationId="AutoBackupCheck" x:Name="AutoBackupCheck" Content="Auto-backup before launch"
                      Checked="OnAutoBackupChanged" Unchecked="OnAutoBackupChanged"
                      ToolTipService.ToolTip="Snapshot the save automatically each time you press Play (older auto snapshots are pruned; your named backups are kept)." />
            <TextBlock Text="keep" VerticalAlignment="Center" Foreground="{StaticResource ThemeInkSoft}" />
            <NumberBox AutomationProperties.AutomationId="KeepCountBox" AutomationProperties.Name="Snapshots to keep" x:Name="KeepBox" Minimum="1" Maximum="999" SpinButtonPlacementMode="Compact"
                       Width="120" ValueChanged="OnKeepChanged" VerticalAlignment="Center"
                       ToolTipService.ToolTip="How many auto snapshots to keep before pruning the oldest. Your named backups are never pruned." />
        </StackPanel>

        <TextBlock x:Name="SaveFilesHeading" Text="Save files" FontWeight="SemiBold" />
        <ListView AutomationProperties.AutomationId="SaveFileList" AutomationProperties.Name="Save files" x:Name="SaveFileList" MaxHeight="168" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SaveFileRow">
                    <Grid ColumnSpacing="8" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource ThemeInk}" Text="{x:Bind Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind TypeLabel}" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" />
                        </StackPanel>
                        <DropDownButton Grid.Column="1" Content="Clone to…" VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind CloneAutomationName}"
                                        ToolTipService.ToolTip="Copy this save to another type — safe, never overwrites">
                            <DropDownButton.Flyout>
                                <MenuFlyout Opening="OnCloneMenuOpening" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="SaveFilesEmpty" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" Visibility="Collapsed" />

        <!-- Worlds. A game that keeps a folder per world (Palworld) has nothing useful in the file
             list above: 72 of its 74 save files live a level down, and the one at the top is shared
             storage rather than anybody's save. The unit a player thinks in is the world, so that is
             what gets listed. Collapsed entirely for games that do not work this way. -->
        <TextBlock x:Name="WorldsHeading" Text="Worlds" FontWeight="SemiBold" Visibility="Collapsed" />
        <ListView AutomationProperties.AutomationId="WorldList" AutomationProperties.Name="Worlds"
                  x:Name="WorldList" MaxHeight="220" SelectionMode="None" Visibility="Collapsed">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SaveWorldRow">
                    <Grid ColumnSpacing="8" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Foreground="{StaticResource ThemeInk}" Text="{x:Bind Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Kind}" Foreground="{StaticResource ThemeAccent}"
                                           FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Detail}" Foreground="{StaticResource ThemeInkDim}"
                                       FontSize="{StaticResource BodyFontSize}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Size}" VerticalAlignment="Center"
                                       Foreground="{StaticResource ThemeInkSoft}" FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="{StaticResource MetaFontSize}" Margin="0,0,4,0" />
                            <Button AutomationProperties.AutomationId="{x:Bind RenameAutomationId}"
                                    AutomationProperties.Name="{x:Bind RenameAutomationName}" Content="Rename"
                                    Click="OnRenameWorld" Tag="{x:Bind}" VerticalAlignment="Center" />
                            <Button AutomationProperties.AutomationId="{x:Bind DuplicateAutomationId}"
                                    AutomationProperties.Name="{x:Bind DuplicateAutomationName}" Content="Duplicate"
                                    Click="OnDuplicateWorld" Tag="{x:Bind}" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Copy this world so you can experiment on the copy" />
                            <Button AutomationProperties.AutomationId="{x:Bind ShareAutomationId}"
                                    AutomationProperties.Name="{x:Bind ShareAutomationName}" Content="Share…"
                                    Click="OnShareWorld" Tag="{x:Bind}" VerticalAlignment="Center"
                                    Visibility="{x:Bind ShareVisibility}"
                                    ToolTipService.ToolTip="Pack this world without your character, to give to someone else" />
                            <Button AutomationProperties.AutomationId="{x:Bind BackupAutomationId}"
                                    AutomationProperties.Name="{x:Bind BackupAutomationName}" Content="Back up"
                                    Click="OnBackupWorld" Tag="{x:Bind}" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Snapshot just this world" />
                            <Button AutomationProperties.AutomationId="{x:Bind RestoreAutomationId}"
                                    AutomationProperties.Name="{x:Bind RestoreAutomationName}" Content="Restore…"
                                    Click="OnRestoreWorld" Tag="{x:Bind}" VerticalAlignment="Center"
                                    Visibility="{x:Bind HasBackupsVisibility}"
                                    ToolTipService.ToolTip="Put this world back from one of its own snapshots" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Text="Characters" FontWeight="SemiBold" />
        <ListView AutomationProperties.AutomationId="CharacterList" AutomationProperties.Name="Characters" x:Name="CharacterList" MaxHeight="200" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:CharacterRow">
                    <Grid ColumnSpacing="8" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource ThemeInk}" Text="{x:Bind Headline}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Detail}" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- The game's own record that mods were loaded when this was saved. Only
                                 shown when the game SAYS so; silence is not a claim of the opposite. -->
                            <TextBlock Text="MADE WITH MODS" VerticalAlignment="Center"
                                       Visibility="{x:Bind ModsVisibility}"
                                       Foreground="{StaticResource ThemeAccent}"
                                       FontSize="{StaticResource MetaFontSize}" />
                            <Button AutomationProperties.AutomationId="{x:Bind EditAutomationId}"
                                    AutomationProperties.Name="{x:Bind EditAutomationName}"
                                    Content="Edit" Click="OnEditCharacter" VerticalAlignment="Center"
                                    Visibility="{x:Bind EditVisibility}"
                                    ToolTipService.ToolTip="Edit stats, runes, name — snapshots before applying" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="CharactersEmpty" Text="No editable characters here. If the folder is right, this game's save format isn't itemized yet."
                   Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" Visibility="Collapsed"
                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        <TextBlock x:Name="EditorCredit" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource MetaFontSize}" TextWrapping="Wrap" />

        <TextBlock Text="Installed save mods" FontWeight="SemiBold" />
        <ListView AutomationProperties.AutomationId="SaveModList" AutomationProperties.Name="Installed save mods" x:Name="SaveModList" MaxHeight="200" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SaveModRow">
                    <Grid ColumnSpacing="8" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource ThemeInk}" Text="{x:Bind Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Detail}" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Reset" Click="OnSaveModReset" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Re-install from the kept source zip — snapshots first" />
                        <Button Grid.Column="2" AutomationProperties.Name="Remove save mod" Click="OnSaveModRemove" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Remove from the save tree — snapshots first">
                            <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource RowTitleFontSize}" Foreground="{StaticResource ThemeDanger}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="SaveModEmpty" Text="No save mods installed. Drop a world zip to install."
                   Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" Visibility="Collapsed" />

        <TextBlock Text="Snapshots" FontWeight="SemiBold" />
            <TextBlock Text="Restore takes a snapshot of your current save first, labeled 'before-restore'."
                       Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap" />
        <ListView AutomationProperties.AutomationId="SnapshotList" AutomationProperties.Name="Snapshots" x:Name="SnapshotList" MaxHeight="260" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SaveRow">
                    <Grid ColumnSpacing="8" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource ThemeInk}" Text="{x:Bind Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Detail}" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" />
                        </StackPanel>
                        <DropDownButton Grid.Column="1" Content="Restore one type" MinWidth="84" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Restore just one save type from this snapshot">
                            <DropDownButton.Flyout>
                                <MenuFlyout Opening="OnRestoreTypeOpening" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button Grid.Column="2" Content="Restore" Click="OnRestore" VerticalAlignment="Center" />
                        <Button Grid.Column="3" AutomationProperties.Name="Delete snapshot" Click="OnDelete" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Delete snapshot">
                            <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource RowTitleFontSize}" Foreground="{StaticResource ThemeDanger}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyText" Text="No snapshots yet. Hit Back up now to make one." Foreground="{StaticResource ThemeInkDim}" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
    </StackPanel>
    </ScrollViewer>
</ContentDialog>
