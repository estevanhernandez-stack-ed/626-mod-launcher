<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModManager.App.IniEdit.IniEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    SecondaryButtonText="Restore previous"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    AutomationProperties.Name="Edit INI">

    <!-- Dialog shell (vibe-glow F-008): 3px accent rail + mono-caps stencil eyebrow + title,
         per the design language's dialog rules. Rail bleeds toward the dialog edges. -->
    <ContentDialog.Title>
        <StackPanel Spacing="6">
            <Border Height="3" Background="{StaticResource ThemeAccent}" Margin="-24,0,-24,4"
                    AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="INI // SNAPSHOT FIRST" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.AccessibilityView="Raw"
                       FontSize="{StaticResource TagFontSize}" CharacterSpacing="80"
                       Foreground="{StaticResource ThemeInkDim}" />
            <TextBlock Text="Edit INI" FontSize="20" FontWeight="SemiBold" />
        </StackPanel>
    </ContentDialog.Title>


    <StackPanel Spacing="8" Width="600" Height="400">
        <TextBlock x:Name="PathLabel" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        <TextBox x:Name="ContentsBox"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="{StaticResource MonoFontFamily}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 Height="320" />
        <TextBlock Text="Saving takes a snapshot of this file first. Restore previous puts back the last snapshot."
                   Foreground="{StaticResource ThemeInkDim}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel>
</ContentDialog>
