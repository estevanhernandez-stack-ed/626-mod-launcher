<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModManager.App.NexusCatalogDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Close" DefaultButton="Close"
    AutomationProperties.Name="Browse Nexus">

    <!-- Dialog shell (vibe-glow F-008): 3px accent rail + mono-caps stencil eyebrow + title,
         per the design language's dialog rules. Rail bleeds toward the dialog edges. -->
    <ContentDialog.Title>
        <StackPanel Spacing="6">
            <Border Height="3" Background="{StaticResource ThemeAccent}" Margin="-24,0,-24,4"
                    AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="NEXUS // BROWSE" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.AccessibilityView="Raw"
                       FontSize="{StaticResource TagFontSize}" CharacterSpacing="80"
                       Foreground="{StaticResource ThemeInkDim}" />
            <TextBlock Text="Browse Nexus" FontSize="{StaticResource ViewTitleFontSize}" FontWeight="SemiBold" />
        </StackPanel>
    </ContentDialog.Title>

    <StackPanel Spacing="10" MinWidth="480">
        <!-- Search row: TextBox (Enter submits) + Search button. Adult content is excluded
             server-side by the plugin, so this dialog does NO client-side filtering — it just
             renders what SearchCatalogAsync returns. -->
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="QueryBox" PlaceholderText="Search mods…" Width="380"
                     KeyDown="OnQueryKeyDown" />
            <Button x:Name="SearchButton" Content="Search" Click="OnSearchClick" />
        </StackPanel>

        <!-- Status line for the Initial / Loading / Empty states. Only one is visible at a time. -->
        <TextBlock x:Name="StatusLabel" TextWrapping="Wrap" Foreground="{StaticResource ThemeInkSoft}" />

        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ResultsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Foreground="{StaticResource ThemeInk}" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Author}" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}"
                                               Visibility="{Binding AuthorVisibility}" />
                                    <TextBlock Text="{Binding Endorsements}" Foreground="{StaticResource ThemeInkSoft}" FontSize="{StaticResource BodyFontSize}"
                                               Visibility="{Binding EndorsementsVisibility}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource ThemeInkDim}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap"
                                           Visibility="{Binding SummaryVisibility}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Get" VerticalAlignment="Center"
                                    Click="OnGetClick"
                                    ToolTipService.ToolTip="Open this mod's page on Nexus to download" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</ContentDialog>
