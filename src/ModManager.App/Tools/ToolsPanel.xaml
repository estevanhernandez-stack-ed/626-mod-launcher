<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ModManager.App.Tools.ToolsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ModManager.Core.Tools"
    xmlns:fw="using:ModManager.Core.Frameworks"
    xmlns:vm="using:ModManager.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Slim tools row, sits above the mod list. Three states share the same StackPanel:
         installed tools render as buttons, catalog entries that apply but aren't installed
         render as HyperlinkButton "Get …" chips, and an empty-state hint appears when both
         lists are empty. The + button is always present so the user can install ad-hoc tools. -->
    <Border BorderThickness="0,0,0,1"
            BorderBrush="{StaticResource ThemeBorder}"
            Background="{StaticResource ThemeBarBg}"
            Padding="12,6">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

            <TextBlock Text="TOOLS"
                       Foreground="{StaticResource ThemeInkSoft}"
                       FontSize="{StaticResource TagFontSize}"
                       FontFamily="{StaticResource StencilFontFamily}" FontStretch="Condensed" FontWeight="SemiBold" CharacterSpacing="80"
                       VerticalAlignment="Center" />

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tools, Mode=OneWay}" VerticalAlignment="Center">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="core:ToolEntry">
                        <Button Padding="10,4"
                                AutomationProperties.Name="{x:Bind DisplayName}" Click="OnToolClick"
                                Tag="{x:Bind}">
                            <!-- ContextFlyout replaces the old RightTapped hook (vibe-glow F-032):
                                 keyboard-reachable (Menu key / Shift+F10), and the tooltip now
                                 names the path so it's discoverable, not a guess. -->
                            <Button.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem AutomationProperties.Name="{x:Bind DisplayName}" Text="Configure…" Click="OnToolConfigureClick" Tag="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE713;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.ContextFlyout>
                            <ToolTipService.ToolTip>
                                <ToolTip>
                                    <TextBlock Foreground="{StaticResource ThemeInk}">
                                        <Run Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                        <LineBreak/>
                                        <Run Text="Catalog metadata only — never bundled." />
                                        <LineBreak/>
                                        <Run Text="Click to launch. Right-click (or Shift+F10) to configure or uninstall." />
                                    </TextBlock>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                            <TextBlock Foreground="{StaticResource ThemeInk}" Text="{x:Bind DisplayName}" />
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.MissingTools, Mode=OneWay}" VerticalAlignment="Center">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="core:KnownTool">
                        <HyperlinkButton Padding="10,4"
                                         AutomationProperties.Name="{x:Bind DisplayName}" Click="OnGetToolClick"
                                         Tag="{x:Bind}"
                                         ToolTipService.ToolTip="Open the download page in your browser">
                            <!-- Style x:Null restores Foreground inheritance from the
                                 HyperlinkButton (the app-wide implicit TextBlock style
                                 would otherwise pin this to ThemeInk and kill the
                                 hover/pressed/disabled link states). -->
                            <TextBlock Text="{x:Bind DisplayName}" Style="{x:Null}" />
                        </HyperlinkButton>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- LOADERS section: detected launcher exes for ban-safe mod loaders (Mod Engine 2,
                 Seamless Co-op, …). Each button launches the loader directly so it can set up
                 the game's mod surface before handing off to the engine. Collapsed when none are
                 detected in the play folder. No #if FULL — on STORE, safe loaders are the
                 primary safe path since the EAC offline toggle is unavailable there. -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasLoaders, Mode=OneWay}">
                <TextBlock Text="LOADERS"
                           Foreground="{StaticResource ThemeInkSoft}"
                           FontSize="{StaticResource TagFontSize}"
                           FontFamily="{StaticResource StencilFontFamily}" FontStretch="Condensed" FontWeight="SemiBold" CharacterSpacing="80"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Loaders, Mode=OneWay}" VerticalAlignment="Center">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:DetectedLoaderRow">
                            <Button Padding="10,4"
                                    AutomationProperties.Name="{x:Bind DisplayName}" Click="OnLoaderClick"
                                    Tag="{x:Bind}">
                                <ToolTipService.ToolTip>
                                    <ToolTip>
                                        <TextBlock Foreground="{StaticResource ThemeInk}">
                                            <Run Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                            <LineBreak/>
                                            <Run Text="Ban-safe mod loader — launches the game via its own entry point." />
                                            <LineBreak/>
                                            <Run Text="Click to launch." />
                                        </TextBlock>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                                <TextBlock Style="{x:Null}">
                                    <Run Text="Launch via " />
                                    <Run Text="{x:Bind DisplayName}" />
                                </TextBlock>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <Button Padding="8,4"
                    AutomationProperties.AutomationId="InstallToolButton" AutomationProperties.Name="Install a tool" Click="OnAddToolClick"
                    ToolTipService.ToolTip="Install a tool from a zip">
                <SymbolIcon Symbol="Add" />
            </Button>

            <TextBlock Text="No tools yet. Drop a zip to install, or click +."
                       VerticalAlignment="Center"
                       Foreground="{StaticResource ThemeInkSoft}"
                       Visibility="{x:Bind ViewModel.ToolsEmptyHintVisibility, Mode=OneWay}" />

            <!-- FRAMEWORKS section, same row as TOOLS. One button per installed framework; clicking it
                 pops a "how to use" toast read live from the framework's installed settings. The whole
                 section is collapsed when no framework is installed for the active game. -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasInstalledFrameworks, Mode=OneWay}">
                <TextBlock Text="FRAMEWORKS"
                           Foreground="{StaticResource ThemeInkSoft}"
                           FontSize="{StaticResource TagFontSize}"
                           FontFamily="{StaticResource StencilFontFamily}" FontStretch="Condensed" FontWeight="SemiBold" CharacterSpacing="80"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.FrameworkRows, Mode=OneWay}" VerticalAlignment="Center">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:FrameworkRowViewModel">
                            <!-- A split affordance: the name opens the how-to toast; the pencil opens the
                                 framework's settings INI in the existing editor (snapshot-first). The pencil
                                 is collapsed when the framework installed no editable .ini.

                                 Wave 9 added the third: Uninstall lived ONLY in the Settings inventory, and
                                 that inventory left. Outlined danger here, filled danger inside the confirm,
                                 per .claude/rules/vsm-danger-buttons.md — and it goes through a confirm the
                                 Settings version never had, because a chip in the main window is a much
                                 easier thing to hit by accident than a button at the bottom of a dialog. -->
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Padding="10,4"
                                        AutomationProperties.AutomationId="{x:Bind ChipAutomationId}"
                                        AutomationProperties.Name="{x:Bind DisplayName}" Click="OnFrameworkClick"
                                        Tag="{x:Bind Manifest}"
                                        ToolTipService.ToolTip="How to use this — click for the in-game keys + mods folder">
                                    <TextBlock Foreground="{StaticResource ThemeInk}" Text="{x:Bind DisplayName}" />
                                </Button>
                                <Button Padding="6,4"
                                        AutomationProperties.Name="{x:Bind EditAutomationName}" Click="OnEditFrameworkConfigClick"
                                        Tag="{x:Bind Manifest}"
                                        Visibility="{x:Bind ConfigVisibility}"
                                        ToolTipService.ToolTip="Edit this framework's settings (e.g. enable the UE4SS console)">
                                    <FontIcon Glyph="&#xE70F;" FontSize="{StaticResource BodyFontSize}" />
                                </Button>
                                <Button Padding="6,4"
                                        AutomationProperties.AutomationId="{x:Bind UninstallAutomationId}"
                                        AutomationProperties.Name="{x:Bind UninstallAutomationName}"
                                        Click="OnUninstallFrameworkClick"
                                        Tag="{x:Bind Manifest}"
                                        Foreground="{StaticResource ThemeDanger}"
                                        ToolTipService.ToolTip="Remove this framework — the launcher reverses its own install">
                                    <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource BodyFontSize}" Foreground="{StaticResource ThemeDanger}" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- The "how to use" toast: a TeachingTip whose title + body are filled in code
                 (OnFrameworkClick) from the live FrameworkUsage read. Lives in the panel (not laid
                 out) so a Border's single-child rule is respected; it anchors to the clicked button. -->
            <TeachingTip x:Name="UsageTip"
                         IsLightDismissEnabled="True"
                         PreferredPlacement="Bottom" />
        </StackPanel>
    </Border>
</UserControl>
